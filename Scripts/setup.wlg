// Run by Install WebLingo.bat from the extracted ZIP, in the account that opened it.
import { write, writeLn, prompt } from "std:console";
import fs from "std:fs";
import process from "std:process";
import { Environment } from "std:env";
import { Json } from "std:json";
import { architectureOf, expand, programFiles, run } from "./windows.wlg";

// WebLingo's extension of Visual Studio's, its Identity in Editors/VisualStudio/extension.vsixmanifest.
const visualStudioExtension = "WebLingo.VisualStudio.77CF6EB6-FE61-422C-9415-F8DFDCCCBF41";

async function choose(question) {
    while (true) {
        var answer = await prompt($"{question} [Y/n/q to cancel] ");
        if (answer == null) return null;
        var choice = answer.trim().toLower();
        if (choice == "" || choice == "y" || choice == "yes") return true;
        if (choice == "n" || choice == "no") return false;
        if (choice == "q") return null;
        writeLn("Enter Y, N or Q.");
    }
}

// VS Code's installer can leave its bin folder off PATH. Also support a custom installation on PATH.
async function findCode() {
    var folders = [
        expand("%LOCALAPPDATA%\\Programs\\Microsoft VS Code\\bin"),
        $"{programFiles("x64")}\\Microsoft VS Code\\bin",
        $"{programFiles("x86")}\\Microsoft VS Code\\bin"
    ];
    foreach (var folder in expand("%PATH%").split(";")) {
        if (folder.trim() != "") folders.push(folder.trim().replace("\"", ""));
    }
    foreach (var folder in folders) {
        var cli = $"{folder}\\code.cmd";
        if (await fs.exists(cli)) return cli;
    }
    return null;
}

// Whether a Visual Studio's own extensions for this account, in its folder of them, have WebLingo's.
async function hasVisualStudioExtension(instance) {
    var folder = expand($"%LOCALAPPDATA%\\Microsoft\\VisualStudio\\{instance["major"]}.0_{instance["id"]}\\Extensions");
    if (!(await fs.isFolder(folder))) return false;
    foreach (var name in await fs.list(folder)) {
        var manifest = $"{folder}\\{name}\\extension.vsixmanifest";
        if ((await fs.exists(manifest)) && (await fs.readText(manifest)).contains($"Id=\"{visualStudioExtension}\"")) return true;
    }
    return false;
}

// Visual Studio 2022 and 2026, each installation vswhere lists that has its own VSIXInstaller and not WebLingo's extension
// yet, as a map: its id, its name, its installer, and its major version, which names its folder of this account's data.
async function findVisualStudio() {
    var vswhere = $"{programFiles("x86")}\\Microsoft Visual Studio\\Installer\\vswhere.exe";
    if (!(await fs.exists(vswhere))) return [];
    var listed = await process.run(vswhere, ["-version", "[17.0,19.0)", "-products", "*", "-format", "json", "-utf8"],
        {"timeoutMs": 60000});
    if (listed["exitCode"] != 0) return [];
    var found = [];
    foreach (var instance in Json.parse(listed["stdout"])) {
        var candidate = {
            "id": instance["instanceId"], "name": instance["displayName"],
            "installer": $"{instance["installationPath"]}\\Common7\\IDE\\VSIXInstaller.exe",
            "major": instance["installationVersion"].split(".")[0]
        };
        if (!(await fs.exists(candidate["installer"]))) continue;
        if (await hasVisualStudioExtension(candidate)) {
            writeLn($"{candidate["name"]} has WebLingo's extension already.");
            continue;
        }
        found.push(candidate);
    }
    return found;
}

// Whether Visual Studio runs, whose extensions its installer then cannot change.
async function visualStudioRuns() {
    var listed = await process.run(expand("%SystemRoot%\\System32\\tasklist.exe"), ["/FI", "IMAGENAME eq devenv.exe", "/NH"],
        {"timeoutMs": 60000});
    return listed["stdout"].toLower().contains("devenv.exe");
}

async function runSetupProgram(executable, args) {
    var result = await process.run(executable, args, {"timeoutMs": 1800000});
    write(result["stdout"]);
    write(result["stderr"]);
    if (result["exitCode"] != 0) throw new Error($"Setup step failed (exit code {result["exitCode"]}).");
}

async function installRuntime() {
    // Only the bundled machine installer crosses UAC. Pass paths as data through Start-Process.
    var powershell = expand("%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe");
    var elevate = "$ErrorActionPreference = 'Stop'; "
        + "$root = (Get-Location).ProviderPath; "
        + "$exe = Join-Path $root 'WebLingo\\weblingo.exe'; "
        + "try { $p = Start-Process -FilePath $exe -WorkingDirectory $root "
        + "-ArgumentList 'run install.wlg' -Verb RunAs -Wait -PassThru; exit $p.ExitCode } "
        + "catch { Write-Output $_.Exception.Message; exit 1 }";
    writeLn("Approve the Windows administrator prompt. When the installer finishes, close its window by pressing a key.");
    await runSetupProgram(powershell, ["-NoProfile", "-NonInteractive", "-Command", elevate]);
}

async function installExtension(code, extension) {
    // Expand both paths once inside quotes in cmd. The .cmd CLI runs as the original user.
    Environment.setVariable("WebLingoSetupCode", code);
    Environment.setVariable("WebLingoSetupVsix", extension);
    var result = await run("\"%WebLingoSetupCode%\" --install-extension \"%WebLingoSetupVsix%\" --force");
    write(result.output);
    if (result.code != 0) {
        throw new Error($"VS Code installation failed. In VS Code, choose Install from VSIX and select {extension}.");
    }
    writeLn("Reopen VS Code, open a .wlg file in a trusted folder, and press F5 to debug.");
}

// Each Visual Studio's VSIXInstaller, quietly, for this account, the extension being one of a user's, once Visual Studio
// is closed.
async function installVisualStudioExtension(instances, extension) {
    while (await visualStudioRuns()) {
        var answer = await prompt("Close Visual Studio, then press Enter, or enter Q to leave its extension out. ");
        if (answer == null || answer.trim().toLower() == "q") {
            writeLn($"To add it later, with Visual Studio closed, open {extension}.");
            return;
        }
    }
    foreach (var instance in instances) {
        writeLn($"Installing WebLingo's extension in {instance["name"]}.");
        var result = await process.run(instance["installer"], ["/quiet", $"/instanceIds:{instance["id"]}", extension],
            {"timeoutMs": 1800000});
        if (result["exitCode"] != 0) {
            throw new Error($"Visual Studio's extension installer failed for {instance["name"]} (exit code "
                + $"{result["exitCode"]}). With Visual Studio closed, open {extension}.");
        }
    }
    writeLn("Open a folder with a .wlg or .wasp file in Visual Studio, and press F5 to debug.");
}

async function setup() {
    var installed = $"{programFiles(await architectureOf("WebLingo", "weblingo"))}\\WebLingo";
    var extension = $"{installed}\\VSCode\\WebLingo.vsix";
    var visualStudioVsix = $"{installed}\\VisualStudio\\WebLingo.VisualStudio.vsix";
    writeLn($"Install WebLingo in {installed} and add it to the machine PATH.");
    var registerFiles = await choose("Run .wlg files with WebLingo when you double-click them?");
    if (registerFiles == null) return false;
    var code = await findCode();
    var installDebugger = false;
    if (code != null) {
        installDebugger = await choose("Enable WebLingo debugging in VS Code for your account?");
        if (installDebugger == null) return false;
    } else {
        writeLn("VS Code was not found. You can add the extension after installing VS Code.");
    }
    // Only a package made where Visual Studio is installed has its extension (Installers/Windows/package.ps1).
    var visualStudio = (await fs.exists("WebLingo\\VisualStudio\\WebLingo.VisualStudio.vsix")) ? await findVisualStudio() : [];
    var installVisualStudio = false;
    if (visualStudio.length > 0) {
        var names = ", ".join(visualStudio.map(instance => instance["name"]));
        installVisualStudio = await choose($"Enable WebLingo debugging in {names} for your account?");
        if (installVisualStudio == null) return false;
    }

    await installRuntime();
    writeLn($"WebLingo is installed in {installed}.");
    if (registerFiles || installDebugger || installVisualStudio) {
        var options = ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", $"{installed}\\uninstall.ps1", "-Remember"];
        if (registerFiles) options.push("-Association");
        if (installDebugger) {
            options.push("-Code");
            options.push(code);
        }
        if (installVisualStudio) {
            options.push("-VisualStudio");
            options.push(";".join(visualStudio.map(instance => instance["id"])));
        }
        await runSetupProgram(expand("%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe"), options);
    }
    if (registerFiles) {
        await runSetupProgram("WebLingo\\weblingo.exe", ["run", "add-wlg-file-type.wlg", $"folder={installed}"]);
        writeLn("If Windows asks how to open a .wlg file, choose WebLingo and Always.");
    }
    if (installDebugger) {
        await installExtension(code, extension);
    } else {
        writeLn($"To add the debugger later, use Install from VSIX in VS Code and choose {extension}.");
    }
    if (installVisualStudio) await installVisualStudioExtension(visualStudio, visualStudioVsix);
    return true;
}

writeLn((await setup()) ? "Setup complete." : "Setup canceled.");
