; WebLingo's debug adapters as engines of Visual Studio's Debug Adapter Host (Editors/README.md, "Visual Studio, with
; WebLingo's extension"): weblingo's, for scripts, and wasp's, for pages and sites, each installed with WebLingo. A launch
; names its adapter itself where the PATH finds another, as WebLingoLaunch.cs does.

[$RootKey$\AD7Metrics\Engine\{C1E04249-C50E-4348-97B3-BC63D6362C41}]
; The Debug Adapter Host, loaded by Visual Studio itself.
"CLSID"="{DAB324E9-7B35-454C-ACA8-F6BB0D5C8673}"
"AlwaysLoadLocal"=dword:00000001
"AddressBP"=dword:00000000
"CallStackBP"=dword:00000000
"Attach"=dword:00000000
"Exceptions"=dword:00000000
"ExceptionConditions"=dword:00000000
"SetNextStatement"=dword:00000000
"Name"="WebLingo"
"Adapter"="$ProgramFiles$\\WebLingo\\weblingo.exe"
"AdapterArgs"="--debug-adapter"
"Language"="WebLingo"
"LanguageId"="{00000000-0000-0000-0000-000000000000}"

[$RootKey$\AD7Metrics\Engine\{6AB59EE8-7802-4FEA-B430-5090D36C0927}]
"CLSID"="{DAB324E9-7B35-454C-ACA8-F6BB0D5C8673}"
"AlwaysLoadLocal"=dword:00000001
