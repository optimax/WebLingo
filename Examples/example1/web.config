<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS runs this site through the ASP.NET Core Module, which starts wasp, WASP's host, from the wasp folder, and passes it
  every request; wasp serves the application in the site folder. The wasp folder is made by publish.ps1 (README.md).
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath=".\wasp\wasp.exe" arguments="serve --root site" hostingModel="outofprocess"
                  stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" />
    </system.webServer>
  </location>
</configuration>
