<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS runs this site through the ASP.NET Core Module, which starts wasp, WASP's host, and passes it every request; wasp
  serves the application in the site folder. wasp is WebLingo's, installed once on the server for all its sites, as PHP
  is, in C:\Program Files\WebLingo (README.md); if it is installed elsewhere, change processPath to match.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="C:\Program Files\WebLingo\wasp.exe" arguments="serve --root site" hostingModel="outofprocess"
                  stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" />
    </system.webServer>
  </location>
</configuration>
