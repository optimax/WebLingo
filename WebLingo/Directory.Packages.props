<Project>
  <PropertyGroup><ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally></PropertyGroup>
  <ItemGroup>
    <!-- SQLite's ADO.NET provider, MIT, with SQLitePCLRaw 2.1.13, Apache-2.0, and SQLite, public domain: WebLingo.Data.DotNet only. -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <!-- SQL Server's ADO.NET provider, MIT, with its dependencies, MIT: WebLingo.Data.DotNet only. Its native network layer
         on Windows, SNI.runtime, under Microsoft's own terms, is referenced only to be left out (specification, section 7.11). -->
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.2" />
    <PackageVersion Include="Microsoft.Data.SqlClient.SNI.runtime" Version="7.1.2" />
    <!-- MySQL's ADO.NET provider, MIT: WebLingo.Data.DotNet. It resolves the MIT logging and DI abstractions to 10.0.15. -->
    <PackageVersion Include="MySqlConnector" Version="3.0.0" />
    <!-- PostgreSQL's ADO.NET provider, PostgreSQL License: WebLingo.Data.DotNet. Reuses the existing logging abstractions. -->
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <!-- .NET's diagnostics client and its events' reader, MIT, Microsoft's: the benchmark alone, which no installer ships,
         reading a server's .NET heap from outside it, as dotnet-counters does (specification, section 9, "M0.22 parts",
         part 3; the owner's answer, 27 November 2026, A2 (a) of "M0.22, Part 3: The Soak with Reloads"). -->
    <PackageVersion Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.750501" />
    <PackageVersion Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="4.0.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
</Project>
