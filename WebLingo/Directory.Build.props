<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- The solution's version, every assembly's, 0.N.0 for M0.N, the last milestone landed whole, which the task that
         lands a milestone raises; weblingo and wasp print it (the owner's answer, 18 November 2026; without its
         "-pre-alpha" since 21 November 2026, the owner's request, "Drop Pre-Alpha"). -->
    <Version>0.21.0</Version>
    <!-- The version as it is, without the commit .NET would add after a '+', so that a build is the same from any checkout. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <!-- The build number, which weblingo and wasp print after the version, and every assembly's file version: the build's
       local time, its year, month, day, and hour and minute, as MaxPad makes it (the owner's request, 21 November 2026),
       each part a number without a leading zero, 2027.1.5.7 for 00:07 on 5 January 2027 (the owner's request,
       25 November 2026, "Build Number"); read from the sortable format, the invariant culture's whatever the machine's,
       taken once so that its parts agree; a build given one, -p:BuildStamp=…, gives it every assembly. -->
  <PropertyGroup Condition="'$(BuildStamp)' == ''">
    <BuildTime>$([System.DateTime]::Now.ToString("s"))</BuildTime>
    <BuildYear>$([System.Int32]::Parse('$(BuildTime.Substring(0, 4))'))</BuildYear>
    <BuildMonth>$([System.Int32]::Parse('$(BuildTime.Substring(5, 2))'))</BuildMonth>
    <BuildDay>$([System.Int32]::Parse('$(BuildTime.Substring(8, 2))'))</BuildDay>
    <BuildHourMinute>$([System.Int32]::Parse('$(BuildTime.Substring(11, 2))$(BuildTime.Substring(14, 2))'))</BuildHourMinute>
    <BuildStamp>$(BuildYear).$(BuildMonth).$(BuildDay).$(BuildHourMinute)</BuildStamp>
  </PropertyGroup>
  <PropertyGroup>
    <FileVersion>$(BuildStamp)</FileVersion>
  </PropertyGroup>
</Project>
