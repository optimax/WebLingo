<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- The solution's version, every assembly's, 0.N.0 for M0.N, the last milestone landed whole, which the task that
         lands a milestone raises; weblingo and wasp print it (the owner's answer, 18 November 2026; without its
         "-pre-alpha" since 21 November 2026, the owner's request, "Drop Pre-Alpha"). -->
    <Version>0.20.0</Version>
    <!-- The version as it is, without the commit .NET would add after a '+', so that a build is the same from any checkout. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <!-- The build number, which weblingo and wasp print after the version, and every assembly's file version: the build's
       local time, yyyy.MM.dd.HHmm, as MaxPad makes it (the owner's request, 21 November 2026), read from the sortable
       format, the invariant culture's whatever the machine's; a build given one, -p:BuildStamp=…, gives it every assembly. -->
  <PropertyGroup Condition="'$(BuildStamp)' == ''">
    <BuildTime>$([System.DateTime]::Now.ToString("s"))</BuildTime>
    <BuildStamp>$(BuildTime.Substring(0, 10).Replace('-', '.')).$(BuildTime.Substring(11, 5).Replace(':', ''))</BuildStamp>
  </PropertyGroup>
  <PropertyGroup>
    <FileVersion>$(BuildStamp)</FileVersion>
  </PropertyGroup>
</Project>
