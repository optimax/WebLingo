<Project>
  <!-- The built-ins written in WebLingo, each a .wlg file beside the code that uses it, its project's WebLingoSource item,
       become constants of a class the build generates, WebLingoSources, in the project's root namespace, one for each file,
       named by it, its text with its line breaks LF and its last one left out: read, edited and checked as WebLingo, and
       compiled into the assembly, nothing read while a program runs (the owner's answer, 22 November 2026, "Built-ins
       Written in WebLingo, in .wlg Files", A1 (a), for now). The task is MSBuild's own, compiled by its C# task factory,
       with no package; the class is written only when its text changes, so that a build with nothing new compiles
       nothing again. -->
  <UsingTask TaskName="WebLingoWriteSources" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Sources ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <Namespace ParameterType="System.String" Required="true" />
      <OutputFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var code = new StringBuilder();
        code.Append("// <auto-generated/>\n");
        code.Append("// The built-ins written in WebLingo, from their .wlg files (Directory.Build.targets).\n");
        code.Append("namespace ").Append(Namespace).Append(";\n\n");
        code.Append("internal static class WebLingoSources\n{\n");
        foreach (var source in Sources)
        {
            var text = File.ReadAllText(source.GetMetadata("FullPath")).Replace("\r\n", "\n").Replace('\r', '\n');
            if (text.EndsWith("\n", StringComparison.Ordinal)) text = text.Substring(0, text.Length - 1);
            code.Append("    /// <summary>").Append(source.ItemSpec.Replace('\\', '/')).Append(".</summary>\n");
            code.Append("    public const string ").Append(source.GetMetadata("Filename")).Append(" = \"");
            foreach (var c in text)
            {
                switch (c)
                {
                    case '\\': code.Append("\\\\"); break;
                    case '"': code.Append("\\\""); break;
                    case '\n': code.Append("\\n"); break;
                    case '\t': code.Append("\\t"); break;
                    default:
                        if (c < ' ' || c > '~') code.Append("\\u").Append(((int)c).ToString("X4"));
                        else code.Append(c);
                        break;
                }
            }
            code.Append("\";\n\n");
        }
        code.Length -= 1;
        code.Append("}\n");
        var generated = code.ToString();
        if (!File.Exists(OutputFile) || File.ReadAllText(OutputFile) != generated)
        {
            Directory.CreateDirectory(Path.GetDirectoryName(OutputFile));
            File.WriteAllText(OutputFile, generated, new UTF8Encoding(false));
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="WebLingoWriteSources" BeforeTargets="CoreCompile" Condition="'@(WebLingoSource)' != ''">
    <WebLingoWriteSources Sources="@(WebLingoSource)" Namespace="$(RootNamespace)"
                          OutputFile="$(IntermediateOutputPath)WebLingoSources.g.cs" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)WebLingoSources.g.cs" />
      <FileWrites Include="$(IntermediateOutputPath)WebLingoSources.g.cs" />
    </ItemGroup>
  </Target>

  <!-- The commit the build was made of, every assembly's metadata, Commit, which weblingo and wasp print after the build
       number, its first seven characters, 2026.11.28.846-841150b (the owner's request, 28 November 2026): the SDK's own
       source control information, SourceRevisionId, which its git task reads from the repository's files, with no git
       program; a build outside a repository has none, and prints the build number alone. The file version stays four
       numbers, as Windows's version resource needs. -->
  <Target Name="WebLingoBuildCommit" BeforeTargets="GetAssemblyAttributes"
          DependsOnTargets="InitializeSourceControlInformation"
          Condition="'$(SourceControlInformationFeatureSupported)' == 'true'">
    <ItemGroup Condition="'$(SourceRevisionId)' != ''">
      <AssemblyMetadata Include="Commit" Value="$(SourceRevisionId)" />
    </ItemGroup>
  </Target>
</Project>
