<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>weblingo</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../WebLingo.Compiler/WebLingo.Compiler.csproj" />
    <ProjectReference Include="../WebLingo.VM/WebLingo.VM.csproj" />
    <ProjectReference Include="../WebLingo.VM.Stack/WebLingo.VM.Stack.csproj" />
    <ProjectReference Include="../WebLingo.StdLib/WebLingo.StdLib.csproj" />
    <ProjectReference Include="../WebLingo.Platform.DotNet/WebLingo.Platform.DotNet.csproj" />
    <ProjectReference Include="../WebLingo.Data.DotNet/WebLingo.Data.DotNet.csproj" />
    <ProjectReference Include="../WebLingo.Templates/WebLingo.Templates.csproj" />
    <!-- Built first, not referenced: a standard module the host loads as any native module is (section 3.9). -->
    <ProjectReference Include="../WebLingo.StdLib.Tasks/WebLingo.StdLib.Tasks.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../WebLingo.StdLib.Fs/WebLingo.StdLib.Fs.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../WebLingo.StdLib.Http/WebLingo.StdLib.Http.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../WebLingo.StdLib.Net/WebLingo.StdLib.Net.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../WebLingo.StdLib.Db/WebLingo.StdLib.Db.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../WebLingo.StdLib.Crypto/WebLingo.StdLib.Crypto.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../WebLingo.StdLib.Env/WebLingo.StdLib.Env.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../WebLingo.StdLib.Math/WebLingo.StdLib.Math.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../WebLingo.StdLib.Path/WebLingo.StdLib.Path.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../WebLingo.StdLib.Url/WebLingo.StdLib.Url.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../WebLingo.StdLib.Csv/WebLingo.StdLib.Csv.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../WebLingo.StdLib.Compression/WebLingo.StdLib.Compression.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../WebLingo.StdLib.Random/WebLingo.StdLib.Random.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../WebLingo.StdLib.Process/WebLingo.StdLib.Process.csproj" ReferenceOutputAssembly="false" />
    <!-- Windows's own native module, windows:com, in windows/ beside the program, which only Windows loads (section 3.10). -->
    <ProjectReference Include="../WebLingo.Windows.Com/WebLingo.Windows.Com.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- std:system, a native module installed with the runtime, in std/ beside its program (section 3.9); and so beside
         every program that references this one, wasp and the tests among them. -->
    <None Include="../WebLingo.StdLib/bin/$(Configuration)/$(TargetFramework)/WebLingo.StdLib.dll" Link="std/system.dll"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="../WebLingo.StdLib.Tasks/bin/$(Configuration)/$(TargetFramework)/WebLingo.StdLib.Tasks.dll" Link="std/tasks.dll"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="../WebLingo.StdLib.Fs/bin/$(Configuration)/$(TargetFramework)/WebLingo.StdLib.Fs.dll" Link="std/fs.dll"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="../WebLingo.StdLib.Http/bin/$(Configuration)/$(TargetFramework)/WebLingo.StdLib.Http.dll" Link="std/http.dll"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="../WebLingo.StdLib.Net/bin/$(Configuration)/$(TargetFramework)/WebLingo.StdLib.Net.dll" Link="std/net.dll"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="../WebLingo.StdLib.Db/bin/$(Configuration)/$(TargetFramework)/WebLingo.StdLib.Db.dll" Link="std/db.dll"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="../WebLingo.StdLib.Crypto/bin/$(Configuration)/$(TargetFramework)/WebLingo.StdLib.Crypto.dll" Link="std/crypto.dll"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="../WebLingo.StdLib.Env/bin/$(Configuration)/$(TargetFramework)/WebLingo.StdLib.Env.dll" Link="std/env.dll"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="../WebLingo.StdLib.Math/bin/$(Configuration)/$(TargetFramework)/WebLingo.StdLib.Math.dll" Link="std/math.dll"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="../WebLingo.StdLib.Path/bin/$(Configuration)/$(TargetFramework)/WebLingo.StdLib.Path.dll" Link="std/path.dll"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="../WebLingo.StdLib.Url/bin/$(Configuration)/$(TargetFramework)/WebLingo.StdLib.Url.dll" Link="std/url.dll"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="../WebLingo.StdLib.Csv/bin/$(Configuration)/$(TargetFramework)/WebLingo.StdLib.Csv.dll" Link="std/csv.dll"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="../WebLingo.StdLib.Compression/bin/$(Configuration)/$(TargetFramework)/WebLingo.StdLib.Compression.dll"
          Link="std/compression.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="../WebLingo.StdLib.Random/bin/$(Configuration)/$(TargetFramework)/WebLingo.StdLib.Random.dll" Link="std/random.dll"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="../WebLingo.StdLib.Process/bin/$(Configuration)/$(TargetFramework)/WebLingo.StdLib.Process.dll" Link="std/process.dll"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="../WebLingo.Windows.Com/bin/$(Configuration)/$(TargetFramework)/WebLingo.Windows.Com.dll" Link="windows/com.dll"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>
