<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>weblingo</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../WebLingo.Compiler/WebLingo.Compiler.csproj" />
    <ProjectReference Include="../WebLingo.VM/WebLingo.VM.csproj" />
    <ProjectReference Include="../WebLingo.StdLib/WebLingo.StdLib.csproj" />
    <ProjectReference Include="../WebLingo.Platform.DotNet/WebLingo.Platform.DotNet.csproj" />
    <ProjectReference Include="../WebLingo.Templates/WebLingo.Templates.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- std:system, a native module installed with the runtime, in std/ beside its program (section 3.9); and so beside
         every program that references this one, welp and the tests among them. -->
    <None Include="../WebLingo.StdLib/bin/$(Configuration)/$(TargetFramework)/WebLingo.StdLib.dll" Link="std/system.dll"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>
