<?xml version="1.0" encoding="utf-8"?>
<!-- weblingo.exe's manifest (specification, section 3.9, "The console: std:console"; the owner's answers, 20 November
     2026, "Console Module", A7): its console allocation policy detached, so that, started without a console, as by a
     double-click, it opens none, a script that imports std:console being given one (WebLingoConsoleSession); started
     from a console, it runs in it. Windows 11 24H2 and later read it; earlier Windows open a console, as before. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity version="1.0.0.0" name="weblingo" />
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <consoleAllocationPolicy xmlns="http://schemas.microsoft.com/SMI/2024/WindowsSettings">detached</consoleAllocationPolicy>
    </windowsSettings>
  </application>
</assembly>
