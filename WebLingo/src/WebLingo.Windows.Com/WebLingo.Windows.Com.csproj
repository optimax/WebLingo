<Project Sdk="Microsoft.NET.Sdk">
  <!-- windows:com, Windows's COM objects, a native module installed with the runtime as windows/com.dll on Windows
       (specification, section 3.10). Adapter-only: IDispatch called through function pointers, by platform invoke. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../WebLingo.Core/WebLingo.Core.csproj" />
    <ProjectReference Include="../WebLingo.Runtime/WebLingo.Runtime.csproj" />
    <ProjectReference Include="../WebLingo.Platform.Abstractions/WebLingo.Platform.Abstractions.csproj" />
  </ItemGroup>
</Project>
