extend Array {
  map(f) {
    checkCallback("map", f);
    var items = this;
    var result = [];
    for (var i = 0; i < items.length; i++) {
      var value = f(items[i]);
      if (value is Task) {
        var later = async (items, f, result, from, value) => {
          result.push(await value);
          for (var j = from + 1; j < items.length; j++) result.push(await f(items[j]));
          return result;
        };
        return later(items, f, result, i, value);
      }
      result.push(value);
    }
    return result;
  }
  select(f) { checkCallback("select", f); return this.map(f); }
  filter(f) {
    checkCallback("filter", f);
    var items = this;
    var result = [];
    for (var i = 0; i < items.length; i++) {
      var item = items[i];
      var keep = f(item);
      if (keep is Task) {
        var later = async (items, f, result, from, keep, item) => {
          if (await keep) result.push(item);
          for (var j = from + 1; j < items.length; j++) {
            var next = items[j];
            if (await f(next)) result.push(next);
          }
          return result;
        };
        return later(items, f, result, i, keep, item);
      }
      if (keep) result.push(item);
    }
    return result;
  }
  where(f) { checkCallback("where", f); return this.filter(f); }
  reduce(f, initial) {
    checkCallback("reduce", f);
    var items = this;
    var total = initial;
    for (var i = 0; i < items.length; i++) {
      total = f(total, items[i]);
      if (total is Task) {
        var later = async (items, f, from, pending) => {
          var sum = await pending;
          for (var j = from + 1; j < items.length; j++) sum = await f(sum, items[j]);
          return sum;
        };
        return later(items, f, i, total);
      }
    }
    return total;
  }
  find(f) {
    checkCallback("find", f);
    var items = this;
    for (var i = 0; i < items.length; i++) {
      var item = items[i];
      var found = f(item);
      if (found is Task) {
        var later = async (items, f, from, found, item) => {
          if (await found) return item;
          for (var j = from + 1; j < items.length; j++) {
            var next = items[j];
            if (await f(next)) return next;
          }
          return null;
        };
        return later(items, f, i, found, item);
      }
      if (found) return item;
    }
    return null;
  }
  any(f) {
    checkCallback("any", f);
    var items = this;
    for (var i = 0; i < items.length; i++) {
      var found = f(items[i]);
      if (found is Task) {
        var later = async (items, f, from, found) => {
          if (await found) return true;
          for (var j = from + 1; j < items.length; j++) {
            if (await f(items[j])) return true;
          }
          return false;
        };
        return later(items, f, i, found);
      }
      if (found) return true;
    }
    return false;
  }
  some(f) { checkCallback("some", f); return this.any(f); }
  all(f) {
    checkCallback("all", f);
    var items = this;
    for (var i = 0; i < items.length; i++) {
      var kept = f(items[i]);
      if (kept is Task) {
        var later = async (items, f, from, kept) => {
          if (!(await kept)) return false;
          for (var j = from + 1; j < items.length; j++) {
            if (!(await f(items[j]))) return false;
          }
          return true;
        };
        return later(items, f, i, kept);
      }
      if (!kept) return false;
    }
    return true;
  }
  every(f) { checkCallback("every", f); return this.all(f); }
  sort(compare = null) { return sortArray(this, compare); }
}
