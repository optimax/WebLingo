extend Array {
  map(f) {
    checkCallback("map", f);
    var items = this;
    var result = [];
    for (var i = 0; i < items.length; i++) {
      var value = f(items[i]);
      if (value is Task) {
        var from = i;
        var later = async () => {
          result.push(await value);
          for (var j = from + 1; j < items.length; j++) result.push(await f(items[j]));
          return result;
        };
        return later();
      }
      result.push(value);
    }
    return result;
  }
  select(f) { checkCallback("select", f); return this.map(f); }
  filter(f) {
    checkCallback("filter", f);
    var items = this;
    var result = [];
    for (var i = 0; i < items.length; i++) {
      var item = items[i];
      var keep = f(item);
      if (keep is Task) {
        var from = i;
        var later = async () => {
          if (await keep) result.push(item);
          for (var j = from + 1; j < items.length; j++) {
            var next = items[j];
            if (await f(next)) result.push(next);
          }
          return result;
        };
        return later();
      }
      if (keep) result.push(item);
    }
    return result;
  }
  where(f) { checkCallback("where", f); return this.filter(f); }
  reduce(f, initial) {
    checkCallback("reduce", f);
    var items = this;
    var total = initial;
    for (var i = 0; i < items.length; i++) {
      total = f(total, items[i]);
      if (total is Task) {
        var from = i;
        var pending = total;
        var later = async () => {
          var sum = await pending;
          for (var j = from + 1; j < items.length; j++) sum = await f(sum, items[j]);
          return sum;
        };
        return later();
      }
    }
    return total;
  }
  find(f) {
    checkCallback("find", f);
    var items = this;
    for (var i = 0; i < items.length; i++) {
      var item = items[i];
      var found = f(item);
      if (found is Task) {
        var from = i;
        var later = async () => {
          if (await found) return item;
          for (var j = from + 1; j < items.length; j++) {
            var next = items[j];
            if (await f(next)) return next;
          }
          return null;
        };
        return later();
      }
      if (found) return item;
    }
    return null;
  }
  any(f) {
    checkCallback("any", f);
    var items = this;
    for (var i = 0; i < items.length; i++) {
      var found = f(items[i]);
      if (found is Task) {
        var from = i;
        var later = async () => {
          if (await found) return true;
          for (var j = from + 1; j < items.length; j++) {
            if (await f(items[j])) return true;
          }
          return false;
        };
        return later();
      }
      if (found) return true;
    }
    return false;
  }
  some(f) { checkCallback("some", f); return this.any(f); }
  all(f) {
    checkCallback("all", f);
    var items = this;
    for (var i = 0; i < items.length; i++) {
      var kept = f(items[i]);
      if (kept is Task) {
        var from = i;
        var later = async () => {
          if (!(await kept)) return false;
          for (var j = from + 1; j < items.length; j++) {
            if (!(await f(items[j]))) return false;
          }
          return true;
        };
        return later();
      }
      if (!kept) return false;
    }
    return true;
  }
  every(f) { checkCallback("every", f); return this.all(f); }
  sort(compare = null) {
    if (compare != null) checkCallback("sort", compare);
    var a = [];
    foreach (var item in this) a.push(item);
    var b = [];
    foreach (var item in a) b.push(item);
    var n = a.length;
    for (var width = 1; width < n; width *= 2) {
      for (var low = 0; low < n; low += 2 * width) {
        var middle = low + width < n ? low + width : n;
        var high = low + 2 * width < n ? low + 2 * width : n;
        var i = low;
        var j = middle;
        for (var k = low; k < high; k++) {
          var right = j < high && (i >= middle || (compare == null ? a[j] < a[i] : compare(a[j], a[i]) < 0));
          if (right) {
            b[k] = a[j];
            j++;
          } else {
            b[k] = a[i];
            i++;
          }
        }
      }
      var swap = a;
      a = b;
      b = swap;
    }
    return a;
  }
}
