<Project Sdk="Microsoft.NET.Sdk">
  <!-- The platform's databases on .NET, through ADO.NET's providers: an adapter, outside the portable core (section 7.11). -->
  <PropertyGroup><OutputType>Library</OutputType></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../WebLingo.Platform.Abstractions/WebLingo.Platform.Abstractions.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="MySqlConnector" />
    <!-- SqlClient's native network layer on Windows, under Microsoft's own terms, left out: SqlClient uses its managed one
         there too, as on Linux (DotNetDatabases), so that everything WebLingo ships is MIT. -->
    <PackageReference Include="Microsoft.Data.SqlClient.SNI.runtime" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>
</Project>
