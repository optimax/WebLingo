<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>wasp</AssemblyName>
    <!-- .NET's server collector, its heaps adapting to the process's size (DATAS), which the load and soak tests chose
         (specification, section 5.6, "The collector"); DOTNET_gcServer=0 in the process's environment chooses the
         workstation one, as the WASP User Manual's section 19 says. weblingo keeps .NET's default, the workstation one. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <GarbageCollectionAdaptationMode>1</GarbageCollectionAdaptationMode>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../WebLingo.Cli/WebLingo.Cli.csproj" />
    <!-- weblingow too, weblingo as a Windows application, so that this output holds the three programs (section 3.9). -->
    <ProjectReference Include="../WebLingo.Windowed.Cli/WebLingo.Windowed.Cli.csproj" />
    <ProjectReference Include="../WebLingo.Templates/WebLingo.Templates.csproj" />
    <ProjectReference Include="../WebLingo.StdLib/WebLingo.StdLib.csproj" />
    <ProjectReference Include="../WebLingo.Hosting/WebLingo.Hosting.csproj" />
    <ProjectReference Include="../WebLingo.Hosting.AspNetCore/WebLingo.Hosting.AspNetCore.csproj" />
    <ProjectReference Include="../WebLingo.Hosting.FastCgi/WebLingo.Hosting.FastCgi.csproj" />
    <ProjectReference Include="../WebLingo.Hosting.Standalone/WebLingo.Hosting.Standalone.csproj" />
  </ItemGroup>
  <!-- wasp serve: an ASP.NET Core application, on Kestrel, or under IIS through the ASP.NET Core Module (section 6.12). -->
  <ItemGroup><FrameworkReference Include="Microsoft.AspNetCore.App" /></ItemGroup>
</Project>
