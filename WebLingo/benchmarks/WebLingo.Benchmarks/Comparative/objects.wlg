import { writeLn } from "std:console";
class Point {
  constructor(x, y) { this.x = x; this.y = y; }
  add(other) { return new Point(this.x + other.x, this.y + other.y); }
  sum() { return this.x + this.y; }
}
var p = new Point(0, 0);
var step = new Point(1, 2);
var total = 0;
for (var i = 0; i < 1000000; i++) {
  p = p.add(step);
  total += p.sum() % 7;
}
writeLn(total);
