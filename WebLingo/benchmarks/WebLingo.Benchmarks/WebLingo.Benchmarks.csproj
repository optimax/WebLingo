<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Every method fully optimized from its first call, so that no VM is timed while .NET's tiers still compile it. -->
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Workloads/*.wlg" LogicalName="Workloads/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Workloads/*.wasp" LogicalName="Workloads/%(Filename)%(Extension)" />
    <!-- The comparison's programs, in each language, run where they are copied (WebLingoComparison). -->
    <None Include="Comparative/*" CopyToOutputDirectory="PreserveNewest" />
    <!-- The load site, which the load command serves, copied for each run (WebLingoLoad; specification, section 5.6, "Under load"). -->
    <None Include="LoadSite/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/WebLingo.Compiler/WebLingo.Compiler.csproj" />
    <ProjectReference Include="../../src/WebLingo.VM/WebLingo.VM.csproj" />
    <ProjectReference Include="../../src/WebLingo.StdLib/WebLingo.StdLib.csproj" />
    <ProjectReference Include="../../src/WebLingo.Templates/WebLingo.Templates.csproj" />
    <!-- Its native modules' loader, the .NET platform, and std/ beside it, std:fs among them (section 3.9). -->
    <ProjectReference Include="../../src/WebLingo.Cli/WebLingo.Cli.csproj" />
    <!-- wasp beside it, which the load command starts to serve the load site, as a process of its own. -->
    <ProjectReference Include="../../src/WebLingo.Wasp.Cli/WebLingo.Wasp.Cli.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The soak's reading of the server's .NET heap, its System.Runtime counters, from outside its process (WebLingoServerCounters). -->
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" />
  </ItemGroup>
</Project>
