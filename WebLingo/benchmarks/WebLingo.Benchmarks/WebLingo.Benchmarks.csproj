<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Every method fully optimized from its first call, so that no VM is timed while .NET's tiers still compile it. -->
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Workloads/*.ws" LogicalName="Workloads/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/WebLingo.Compiler/WebLingo.Compiler.csproj" />
    <ProjectReference Include="../../src/WebLingo.VM/WebLingo.VM.csproj" />
    <ProjectReference Include="../../src/WebLingo.VM.Stack/WebLingo.VM.Stack.csproj" />
    <ProjectReference Include="../../src/WebLingo.StdLib/WebLingo.StdLib.csproj" />
  </ItemGroup>
</Project>
