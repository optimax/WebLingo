<Project>
  <!-- ReadyToRun (specification, section 9, M0.25): the JIT's work done when WebLingo is published, for its programs'
       start-up, wherever the publish names a runtime, as the installers' do; -p:PublishReadyToRun=false publishes without it.
       Its symbols, .pdb files, are not made, as the publish keeps none (below). -->
  <PropertyGroup Condition="'$(PublishReadyToRun)' == '' and ('$(RuntimeIdentifier)' != '' or '$(UseCurrentRuntimeIdentifier)' == 'true')">
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishReadyToRunEmitSymbols>false</PublishReadyToRunEmitSymbols>
  </PropertyGroup>
  <!-- The VM left to the JIT: its dispatch method, called once for a program's run and looping for all of it, would stay in
       its precompiled code, which inlines nothing from another assembly, the runtime's values among it, and which the JIT
       never compiles again for a method that loops, so that `loops` took twice as long (Documents/implementation.md,
       "ReadyToRun Leaves the VM to the JIT"). -->
  <ItemGroup Condition="'$(PublishReadyToRun)' == 'true'">
    <PublishReadyToRunExclude Include="WebLingo.VM.dll" />
  </ItemGroup>
  <!-- The native modules, std/ and windows/, which the publish copies as files rather than as references, compiled too: the
       SDK compiles such a file only where its PostprocessAssembly says so. -->
  <Target Name="ReadyToRunWebLingoModules" AfterTargets="_ComputeAssembliesToPostprocessOnPublish"
      Condition="'$(PublishReadyToRun)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(ResolvedFileToPublish.RelativePath)',
          '^(std|windows)[\\/][^\\/]+\.dll$'))">
        <PostprocessAssembly>true</PostprocessAssembly>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
  <!-- Apply to the publish file list only. Build outputs still carry their debugging symbols. -->
  <Target Name="SelectWebLingoRuntimeFiles" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <_WebLingoPublishExtra Include="@(ResolvedFileToPublish)"
          Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'
              or $([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').EndsWith('.resources.dll'))" />
      <ResolvedFileToPublish Remove="@(_WebLingoPublishExtra)" />
    </ItemGroup>
    <!-- A local publish can update an existing folder, even after the SDK's obj folder was cleaned. -->
    <WriteLinesToFile Condition="'$(WebLingoPublishExtrasFile)' != ''" File="$(WebLingoPublishExtrasFile)"
        Lines="@(_WebLingoPublishExtra->'%(RelativePath)')" Overwrite="true" />
  </Target>
</Project>
