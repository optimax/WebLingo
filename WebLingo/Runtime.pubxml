<Project>
  <!-- Apply to the publish file list only. Build outputs still carry their debugging symbols. -->
  <Target Name="SelectWebLingoRuntimeFiles" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <_WebLingoPublishExtra Include="@(ResolvedFileToPublish)"
          Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'
              or $([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').EndsWith('.resources.dll'))" />
      <ResolvedFileToPublish Remove="@(_WebLingoPublishExtra)" />
    </ItemGroup>
    <!-- A local publish can update an existing folder, even after the SDK's obj folder was cleaned. -->
    <WriteLinesToFile Condition="'$(WebLingoPublishExtrasFile)' != ''" File="$(WebLingoPublishExtrasFile)"
        Lines="@(_WebLingoPublishExtra->'%(RelativePath)')" Overwrite="true" />
  </Target>
</Project>
