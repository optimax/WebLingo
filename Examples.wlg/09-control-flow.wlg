// 09-control-flow.wlg: choosing and repeating.

// if is a statement, and an expression too, its else required there; c ? a : b is the same, as in C#.
var temperature = 85;
var advice = if (temperature > 90) "too hot for green tea" else "fine";
writeLn([advice, temperature >= 80 ? "warm" : "cool"]);

// ?? gives a default for null, and ??= assigns one only where there is null.
var options = { colour: null };
options["colour"] ??= "green";
writeLn([options["colour"], null ?? "none"]);

// switch has no fall-through and needs no break; a case may list values, or match a class, naming its value.
function kind(value) {
  switch (value) {
    case 0 { return "zero"; }
    case 1, 2, 3 { return "small"; }
    case String s { return $"the text '{s}'"; }
    default { return "something else"; }
  }
}
writeLn([kind(0), kind(2), kind("tea"), kind(4.5)]);

// switch is an expression too, as in C#.
function size(n) {
  return n switch { 0 => "none", 1 => "one", Integer i => $"{i} of them", _ => "?" };
}
writeLn([size(0), size(1), size(7), size("x")]);

// Loops: while, do-while, for and foreach, with break and continue.
var found = [];
for (var i = 1; i <= 20; i++) {
  if (i % 2 == 0) continue;
  if (i > 9) break;
  found.push(i);
}
var n = 1;
while (n < 100) n *= 3;
var tries = 0;
do { tries++; } while (tries < 3);
writeLn([found, n, tries]);

// A map's entries come in no defined order: a program that needs one sorts them.
var steeping = [];
foreach (var (tea, minutes) in { green: 2, black: 4 }) {
  steeping.push($"{tea}: {minutes} min");
}
writeLn(steeping.sort());

/* Output:
["fine", "warm"]
["green", "none"]
["zero", "small", "the text 'tea'", "something else"]
["none", "one", "7 of them", "?"]
[[1, 3, 5, 7, 9], 243, 3]
["black: 4 min", "green: 2 min"]
*/
