// 21-database.wlg: a database, with std:db, here SQLite's, in memory.
//
// A statement's values are given apart from its text, each named @name, and never written into the SQL: a value
// cannot change what a statement does, so that SQL injection has nowhere to start.

import { Database } from "std:db";

using (var db = await Database.open("sqlite::memory:")) {
  await db.execute("CREATE TABLE Teas (Id INTEGER PRIMARY KEY, Name TEXT, Price DECIMAL(10, 2), Stock INTEGER)");
  foreach (var tea in [{ name: "Sencha", price: 4.5m, stock: 12 }, { name: "Assam", price: 3.25m, stock: 0 }]) {
    await db.execute("INSERT INTO Teas (Name, Price, Stock) VALUES (@name, @price, @stock)", tea);
  }

  // A hostile value stays a value: this name is stored as it is, and drops nothing.
  await db.execute("INSERT INTO Teas (Name, Price, Stock) VALUES (@name, 1, 1)", { name: "x'); DROP TABLE Teas; --" });

  var rows = await db.query("SELECT Name, Price FROM Teas WHERE Stock > @min ORDER BY Name", { min: 0 });
  foreach (var row in rows) writeLn($"{row["Name"]}: {row["Price"]:F2}");

  // A transaction commits when its function ends, and rolls back where it throws.
  try {
    await db.transaction(async () => {
      await db.execute("UPDATE Teas SET Stock = Stock - 5 WHERE Name = 'Sencha'");
      throw new Error("payment refused");
    });
  } catch (e) {
    writeLn(e.message);
  }
  writeLn((await db.query("SELECT Stock FROM Teas WHERE Name = 'Sencha'"))[0]["Stock"]);

  // The database's own refusal is a DatabaseError.
  try {
    await db.query("SELECT * FROM Coffees");
  } catch (DatabaseError e) {
    writeLn([e.code, e.message]);
  }
}

/* Output:
Sencha: 4.50
x'); DROP TABLE Teas; --: 1.00
payment refused
12
["WL3015", "SQLite Error 1: 'no such table: Coffees'."]
*/
