// 17-parameters.wlg: a script's parameters, given on the command line.
// Run: weblingo run 17-parameters.wlg name=Anna cups=3
//
// A script declares its parameters with param, before its other statements, a default making one optional. Each is
// given after the script's name as name=value, always a string: the script converts it, since nothing converts
// implicitly. A parameter the script does not declare, or a required one left out, is an error before it runs.

param name;
param cups = "1";
param greeting = "Hello";

var count = Integer.parse(cups);
writeLn($"{greeting}, {name}: {count} {(count == 1 ? "cup" : "cups")} of tea.");
writeLn([name is String, cups is String, count is Integer]);

/* Output:
Hello, Anna: 3 cups of tea.
[true, true, true]
*/
