// 13-errors.wlg: throwing and catching.
//
// Any value may be thrown, but errors are instances of Error, or of a class extending it, with a message and a code.
// A runtime error is one of them, of a class of its own, so that a catch may name the kind it handles.

import { writeLn } from "std:console";
class NotFoundError extends Error {
  constructor(what) { super($"{what} was not found."); this.what = what; }
}

function find(name) {
  if (name == "sencha") return "green tea";
  throw new NotFoundError(name);
}

// Catches are tried in order; one without a class catches anything, and finally runs on every way out.
function lookUp(name) {
  try {
    return find(name);
  } catch (NotFoundError e) {
    return $"none ({e.what})";
  } finally {
    writeLn($"looked up {name}");
  }
}
writeLn(lookUp("sencha"));
writeLn(lookUp("matcha"));

// A runtime error is an Error with a code: the classes name each kind.
var errors = [];
foreach (var action in [() => [1][5], () => { return {}["x"]; }, () => 1 + "a", () => null.length]) {
  try { action(); } catch (Error e) { errors.push($"{e.__instanceOf.__className} {e.code}"); }
}
writeLn(errors);

// throw; inside a catch throws the caught exception on, keeping where it came from.
function guarded() {
  try { find("oolong"); } catch (e) { writeLn("logging, then passing it on"); throw; }
}
try { guarded(); } catch (NotFoundError e) { writeLn(e.message); }

// A catch may name a kind of value, since every value has a class; and only a catch without a class catches null.
try { throw "just a string"; } catch (String s) { writeLn($"a string: {s}"); }
try { throw null; } catch (e) { writeLn([e]); }

// An exception nothing catches stops the script, with exit code 3 and a message saying where it was thrown.

/* Output:
looked up sencha
green tea
looked up matcha
none (matcha)
["IndexError WL3005", "KeyError WL3007", "TypeError WL3001", "MemberError WL3006"]
logging, then passing it on
oolong was not found.
a string: just a string
[null]
*/
