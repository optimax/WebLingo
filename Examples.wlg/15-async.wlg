// 15-async.wlg: asynchrony with async, await and tasks.
//
// A program's tasks take turns on one worker, switching only at await, so that no two run at once and nothing needs a
// lock. A script's top level may await, as an async function's body may.

import { all } from "std:tasks";

async function brew(tea, minutes) {
  await delay(minutes * 10);
  return $"{tea} after {minutes} min";
}

// An async function starts when called, and gives a task; await waits for its result.
writeLn(await brew("green", 2));

// Tasks run at once: Task.all waits for all of them, in their order, whichever finishes first.
var started = [brew("black", 4), brew("white", 1), brew("oolong", 3)];
writeLn(await Task.all(started));
writeLn(await all([1, brew("mint", 1)]));    // std:tasks exports the same, and any value may be awaited

// Task.any gives the first to finish; Task.timeout gives up on a task that takes too long.
writeLn(await Task.any([brew("slow", 9), brew("quick", 1)]));
try {
  await Task.timeout(brew("forgotten", 50), 20);
} catch (TimeoutError e) {
  writeLn(e.code);
}

// A task completed by hand: new Task() is pending until someone calls complete(value) or fail(error).
var ready = new Task();
async function kettle() { await delay(10); ready.complete("boiling"); }
kettle();
writeLn(await ready);
writeLn(ready.complete("again"));    // a task is completed once; complete says whether it did

// A program left waiting for a task nothing can complete is told so, rather than hanging.
var never = new Task();
try {
  await never;
} catch (DeadlockError e) {
  writeLn(e.code);
}

// An exception in a task nothing awaits still stops the program at its end, unless the task is forgotten on purpose.
async function failing() { throw new Error("nobody cares"); }
failing().forget();
writeLn("done");

/* Output:
green after 2 min
["black after 4 min", "white after 1 min", "oolong after 3 min"]
[1, "mint after 1 min"]
quick after 1 min
WL3010
boiling
false
WL3020
done
*/
