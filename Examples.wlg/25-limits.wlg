// 25-limits.wlg: the limits every execution runs within, and what happens at them.
//
// A script cannot take the machine with it: its memory, the depth of its calls and, where its host sets one, the
// instructions it runs are bounded, and running past a limit stops it, with WL3003, which no catch can catch, so that
// a script cannot swallow it and go on. A host stops an execution the same way when it cancels it, WL3004.

function deeper(n) {
  return deeper(n + 1) + 1;   // never ends on its own
}

writeLn("Going deeper...");
try {
  deeper(0);
} catch (e) {
  writeLn("never written: the limit cannot be caught");
} finally {
  writeLn("never written either: the execution stops at once");
}

/* Output:
Going deeper...
*/
/* Errors:
25-limits.wlg(8,10): ERROR WL3003: The calls nest more than 10000 deep, which this execution allows.
*/
