// this-outside-a-method.wlg: this exists only in a method or a constructor.
// A function that is no method has no this to be called with by accident; one that wants a receiver names it,
// function (this, …).

function describe() { return this.name; }

/* Errors:
this-outside-a-method.wlg(5,30): ERROR WL2009: 'this' is only allowed in a method or a constructor.
*/
