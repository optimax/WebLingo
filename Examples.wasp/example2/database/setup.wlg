    { slug: "guppy", name: "Guppy", species: "Poecilia reticulata", water: "freshwater",
      origin: "Venezuela, Trinidad and the Guianas", size: 4, low: 22, high: 28, care: "easy", temperament: "peaceful",
      price: 3.90m, stock: 60,
      description: "A live-bearer bred for its colours for a century; this one is a cobra-green male.",
      author: "5snake5", licence: "CC0", source: "https://commons.wikimedia.org/wiki/File:Poecilia_reticulata_-_Guppy,_male,_cobra-green_morph.jpg" },
    { slug: "angelfish", name: "Angelfish", species: "Pterophyllum scalare", water: "freshwater",
      origin: "the Amazon basin", size: 15, low: 24, high: 30, care: "moderate", temperament: "semi-aggressive",
