    { slug: "royal-gramma", name: "Royal gramma", species: "Gramma loreto", water: "marine",
      origin: "the Caribbean", size: 8, low: 24, high: 27, care: "easy", temperament: "peaceful",
      price: 29.00m, stock: 12,
      description: "Purple in front and yellow behind, it hides in the rockwork and keeps the peace.",
      author: "Brian Gratwicke", licence: "CC BY 2.0", source: "https://commons.wikimedia.org/wiki/File:Gramma_loreto,_Fairy_Basslet.jpg" }
];

const orders = [
    { slug: "neon-tetra", quantity: 12, customer: "Ana", placed: DateTime.utc(2026, 11, 14, 10, 5) },
    { slug: "corydoras", quantity: 6, customer: "Ana", placed: DateTime.utc(2026, 11, 14, 10, 6) },
    { slug: "clownfish", quantity: 2, customer: "Tomás", placed: DateTime.utc(2026, 11, 15, 16, 40) }
];

using (var db = await Database.open("fish")) {
    await db.transaction(async () => {
        await db.execute("DROP TABLE IF EXISTS CartItems");
        await db.execute("DROP TABLE IF EXISTS Orders");
        await db.execute("DROP TABLE IF EXISTS Fish");
        await db.execute("""
            CREATE TABLE Fish (
                Id INTEGER PRIMARY KEY,
                Slug TEXT NOT NULL UNIQUE,
                Name TEXT NOT NULL,
                Species TEXT NOT NULL,
                Water TEXT NOT NULL CHECK (Water IN ('freshwater', 'marine')),
                Origin TEXT NOT NULL,
                SizeCm REAL NOT NULL,
                LowC INTEGER NOT NULL,
                HighC INTEGER NOT NULL,
                Care TEXT NOT NULL,
                Temperament TEXT NOT NULL,
                Price DECIMAL(10, 2) NOT NULL,
                Stock INTEGER NOT NULL CHECK (Stock >= 0),
                Description TEXT NOT NULL,
                PhotoAuthor TEXT NOT NULL,
                PhotoLicence TEXT NOT NULL,
                PhotoSource TEXT NOT NULL
            )
            """);
        await db.execute("""
            CREATE TABLE Orders (
                Id INTEGER PRIMARY KEY,
                FishId INTEGER NOT NULL REFERENCES Fish (Id),
                Quantity INTEGER NOT NULL CHECK (Quantity > 0),
                Customer TEXT NOT NULL,
                Placed DATETIME NOT NULL
            )
            """);
        // Each shopping cart's fish, by the cart's id, which its browser keeps in a cookie; a fish once in a cart.
        await db.execute("""
            CREATE TABLE CartItems (
                Cart TEXT NOT NULL,
                FishId INTEGER NOT NULL REFERENCES Fish (Id),
                Quantity INTEGER NOT NULL CHECK (Quantity BETWEEN 1 AND 100),
                Added DATETIME NOT NULL,
                PRIMARY KEY (Cart, FishId)
            )
            """);
        foreach (var one in fish) {
            await db.execute("""
                INSERT INTO Fish (Slug, Name, Species, Water, Origin, SizeCm, LowC, HighC, Care, Temperament, Price, Stock,
                                  Description, PhotoAuthor, PhotoLicence, PhotoSource)
                VALUES (@slug, @name, @species, @water, @origin, @size, @low, @high, @care, @temperament, @price, @stock,
                        @description, @author, @licence, @source)
                """, one);
        }
        foreach (var order in orders) {
            await db.execute("""
                INSERT INTO Orders (FishId, Quantity, Customer, Placed)
                SELECT Id, @quantity, @customer, @placed FROM Fish WHERE Slug = @slug
                """, order);
        }
    });
    var counts = (await db.query("SELECT (SELECT COUNT(*) FROM Fish) AS Fish, (SELECT COUNT(*) FROM Orders) AS Orders"))[0];
    writeLn($"fish.db has {counts["Fish"]} fish and {counts["Orders"]} orders.");
}
