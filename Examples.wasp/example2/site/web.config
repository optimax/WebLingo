<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS runs this site through the ASP.NET Core Module, which starts wasp, WASP's host, and passes it every request; wasp
  serves the application in this folder, as PHP serves a PHP site's, and never this file. wasp is WebLingo's, installed
  once on the server for all its sites, as PHP is, in C:\Program Files\WebLingo (Examples.wasp/README.md); if it is installed
  elsewhere, change processPath to match. wasp's output, when stdoutLogEnabled is true, goes outside the site, to
  C:\inetpub\logs\WebLingo, so that it is neither served nor taken for a change to the site.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="C:\Program Files\WebLingo\wasp.exe" arguments="serve" hostingModel="outofprocess"
                  stdoutLogEnabled="false" stdoutLogFile="C:\inetpub\logs\WebLingo\example2" />
    </system.webServer>
  </location>
</configuration>
