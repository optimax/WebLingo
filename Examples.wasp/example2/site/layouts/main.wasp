<% param title; param section = ""; param request; import { cartOf, countOf } from "/lib/cart.wl"; %>
<%
  // How many fish this browser's cart holds, for the header.
  var inCart = await countOf(cartOf(request));
%>
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Lingo Aquatics</title>
  <link rel="stylesheet" href="/css/site.css">
</head>
<body>
<% include "/includes/header.wasp"; %>
<main>
<% renderBody(); %>
</main>
<% include "/includes/footer.wasp"; %>
</body>
</html>
