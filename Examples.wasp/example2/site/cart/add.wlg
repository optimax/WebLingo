// /cart/add, posted by a fish's page: the fish added to this browser's cart, a cart made for it if it has none, then the
// browser sent on to its cart. A route handler: it answers POST only, any other method a 405.

import { cartFor, add, refuse, toCart } from "/lib/cart.wlg";
import { idOf } from "/lib/store.wlg";

export async function post(request, response) {
    var form = await request.form();
    var fish = idOf(form?["fish"]);
    var quantity = idOf(form?["quantity"]);
    if (fish == null || quantity == null || quantity < 1 || quantity > 100) {
        refuse(response, "A cart takes 1 to 100 of a fish.");
        return;
    }
    if (!(await add(cartFor(request, response), fish, quantity))) {
        refuse(response, "We have no such fish.");
        return;
    }
    toCart(response);
}
