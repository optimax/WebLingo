// Makes WebLingo Forum's database in the database weblingo.config names "forum": SQLite's file ../data/forum.db, as it
// comes, or a database of SQL Server's, MySQL's or PostgreSQL's, made empty by its administrator, whose connection string
// this folder's weblingo.config and the site's wasp.config both give instead (Documents/weblingo-forum.md, section 3.3).
// A new database gets the forum's tables, its groups, its first administrator, and a first category, board and topic; a
// database an earlier version of the forum made is upgraded to this one's; and one at this version is left as it is.
// The folder of members' files, which the site's wasp.config lets it write, ../data/uploads, is made where it is not; a
// relative path is from the current folder, so run it from this folder, or give uploads= the folder's path.
// Run it from this folder:
//
//   weblingo run setup.wlg
//   weblingo run setup.wlg name=Anna email=anna@example.com
//   weblingo run setup.wlg uploads=D:/forum/data/uploads
//
// It asks for what its parameters do not give: the administrator's name, address and password, the password unseen.

param name = null;
param email = null;
param password = null;
param database = "forum";
param uploads = "../data/uploads";

import { write, writeLn, prompt, readPassword } from "std:console";
import fs from "std:fs";
import { DateTime } from "std:datetime";
import { Database } from "std:db";
import schema from "../site/lib/schema.wlg";
import { insert } from "../site/lib/sql.wlg";
import users from "../site/lib/users.wlg";
import { load } from "../site/lib/texts.wlg";
import permissions from "../site/lib/permissions.wlg";
import search from "../site/lib/search.wlg";

var texts = await load("en");

// A value its parameter gives, or the one asked for, checked by problem, which gives the name of a text that says what is
// wrong with it, or null.
async function given(value, question, problem, unseen) {
    var answer = value;
    while (true) {
        if (answer == null) {
            if (unseen) {
                write(question);
                answer = await readPassword();
            } else {
                answer = await prompt(question);
            }
            if (answer == null) {
                throw new Error("The input ended before the administrator was given.");
            }
        }
        var wrong = problem(answer);
        if (wrong == null) {
            return answer.trim() == answer || unseen ? answer : answer.trim();
        }
        if (value != null) {
            throw new Error(texts.get(wrong));
        }
        writeLn(texts.get(wrong));
        answer = null;
    }
}

// The forum's tables, its groups, its administrator, and its first category, board, topic and post.
async function make(db, admin) {
    foreach (var statement in schema.create(db.provider)) {
        await db.execute(statement);
    }
    await db.execute("INSERT INTO schema_version (version) VALUES (@version)", { version: schema.version });
    var now = DateTime.utcNow();
    var groups = {};
    foreach (var group in [["guests", "Guests"], ["members", "Members"], ["moderators", "Moderators"], ["administrators", "Administrators"]]) {
        groups[group[0]] = await insert(db, "member_groups", { name: group[1], kind: group[0] });
    }
    var user = await users.make(db, admin["name"], admin["email"], admin["passwordHash"], now, now);
    foreach (var kind in ["members", "administrators"]) {
        await users.join(db, user, kind);
    }
    var category = await insert(db, "categories", { name: "General", sort_order: 1 });
    var board = await insert(db, "boards", {
        category_id: category, name: "Welcome", description: "Introductions, and news of the forum.", sort_order: 1,
        topic_count: 1, post_count: 1, last_post_id: null });
    await permissions.giveDefaults(db, board);
    var topic = await insert(db, "topics", {
        board_id: board, user_id: user, title: "Welcome to the forum", created_at: now, post_count: 1, view_count: 0,
        last_post_id: null, last_post_at: now, pinned: true, locked: false, deleted: false });
    var post = await insert(db, "posts", {
        topic_id: topic, user_id: user, created_at: now, edited_at: null, edited_by: null, deleted: false,
        body: "This is the forum's first post. Introduce yourself here, and read the forum's news." });
    await db.execute("UPDATE topics SET last_post_id = @post WHERE id = @topic", { post: post, topic: topic });
    await db.execute("UPDATE boards SET last_post_id = @post WHERE id = @board", { post: post, board: board });
    await db.execute("UPDATE users SET post_count = 1 WHERE id = @user", { user: user });
    await search.indexAll(db);
}

// A folder, made, with the folders it is in, where it is not there.
async function makeFolders(path) {
    var at = path.replace("\\", "/").trimEnd("/");
    if (at == "" || await fs.exists(at)) {
        return;
    }
    var slash = at.lastIndexOf("/");
    if (slash > 0) {
        await makeFolders(at.slice(0, slash));
    }
    await fs.makeFolder(at);
}

await makeFolders(uploads);

using (var db = await Database.open(database)) {
    var version = await schema.versionOf(db);
    if (version == schema.version) {
        writeLn($"The forum's database '{database}' is at version {version} already: nothing to do.");
    } else if (version > schema.version) {
        throw new Error($"The forum's database '{database}' is at version {version}, later than this forum's, {schema.version}.");
    } else if (version != 0) {
        // The tables added since, what they hold at first, and the version, in one transaction where the database takes DDL
        // in one: from version 4, each board's permissions for each group, its defaults; from version 6, the search's index
        // of the posts there are.
        async function upgrade() {
            foreach (var statement in schema.upgrade(db.provider, version)) {
                await db.execute(statement);
            }
            if (version < 4) {
                foreach (var board in await db.query("SELECT id FROM boards")) {
                    await permissions.giveDefaults(db, board["id"]);
                }
            }
            if (version < 6) {
                await search.indexAll(db);
            }
            await db.execute("UPDATE schema_version SET version = @version", { version: schema.version });
        }
        if (db.provider == "mysql") {
            await upgrade();
        } else {
            await db.transaction(upgrade);
        }
        writeLn($"Upgraded the forum's database '{database}' on {db.provider} from version {version} to {schema.version}.");
    } else {
        var admin = {
            name: await given(name, "The administrator's name: ", users.nameProblem, false),
            email: await given(email, "The administrator's address: ", users.emailProblem, false),
            password: await given(password, "The administrator's password: ", users.passwordProblem, true)
        };
        admin["passwordHash"] = await users.hash(admin["password"]);
        // Made in one transaction where the database takes DDL in one, so that a failure leaves nothing behind; MySQL
        // commits each statement of DDL as it runs it.
        if (db.provider == "mysql") {
            await make(db, admin);
        } else {
            await db.transaction(async () => { await make(db, admin); });
        }
        writeLn($"Made the forum's database '{database}' on {db.provider}, version {schema.version}, with its administrator {admin['name'].trim()}.");
    }
}
