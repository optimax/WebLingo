// The forum as a request sees it: its settings, its texts, the member signed in, what they may do on each board, and
// the time zone its dates are shown in, read once for each request, since a module runs once for each request that
// imports it (the WASP User Manual, section 8); and what its pages share: their forms, their redirects, and the member a
// session keeps.

import { Database } from "std:db";
import { DateTime } from "std:datetime";
import settings from "./settings.wlg";
import { load } from "./texts.wlg";
import permissions from "./permissions.wlg";
import { banOf } from "./moderation.wlg";
import messages from "./messages.wlg";

export class Forum {
    constructor(values, texts, user, can) {
        this.settings = values;
        this.texts = texts;
        this.user = user;
        this.permissions = can;
        this.zone = user?["time_zone"] ?? values["timeZone"];
        // How many private messages are new to the member.
        this.unread = 0;
        this.kept = {};
    }

    // Whether the reader has a permission on a board: see, read, start, reply, edit, delete or moderate.
    can(board, name) {
        return this.permissions.has(board, name);
    }

    // A text by its name, and a text with values, in the reader's language.
    t(name) { return this.texts.get(name); }
    f(name, values) { return this.texts.format(name, values); }

    // A date as the forum shows it, in the reader's time zone.
    time(date) {
        return date == null ? "" : date.toZone(this.zone).format("d MMMM yyyy, HH:mm");
    }

    // What work gives, the first time a request asks for it by its name; the same again after, so that a page and its
    // layout ask the database once.
    async once(name, work) {
        if (!this.kept.has(name)) {
            this.kept[name] = await work();
        }
        return this.kept[name];
    }
}

var current = null;

// The request's forum.
export async function begin(request) {
    if (current == null) {
        var values = null;
        var user = null;
        var can = null;
        var unread = 0;
        using (var db = await open()) {
            values = await settings.load(db);
            user = await signedIn(db, request);
            can = await permissions.of(db, user?["id"]);
            unread = user == null ? 0 : await messages.unread(db, user["id"]);
        }
        current = new Forum(values, await load(user?["language"] ?? values["language"]), user, can);
        current.unread = unread;
    }
    return current;
}

// The member the request's session keeps, whose address is confirmed, with when they joined, or null, as for a member
// banned; when they were last seen kept, to five minutes.
async function signedIn(db, request) {
    var id = request.session?["user"];
    if (!(id is Integer)) {
        return null;
    }
    var rows = await db.query("""
        SELECT id, name, email, time_zone, language, signature, created_at, last_seen_at FROM users
        WHERE id = @id AND confirmed_at IS NOT NULL
        """, { id: id });
    var now = DateTime.utcNow();
    if (rows.length == 0 || await banOf(db, id, now) != null) {
        return null;
    }
    if (rows[0]["last_seen_at"] == null || now - rows[0]["last_seen_at"] > 5 * 60 * 1000) {
        await db.execute("UPDATE users SET last_seen_at = @now WHERE id = @id", { now: now, id: id });
    }
    return rows[0];
}

// Signs a member in: the session given a new id, so that one someone saw before does not become theirs, and kept.
export function signIn(request, user) {
    request.session.renew();
    request.session["user"] = user;
}

// The forum's database, which wasp.config names "forum".
export async function open() {
    return await Database.open("forum");
}

// A page's view: its forum, its title, and the trail of links above it, each a text and its link; its own data are
// fields its page gives it.
export function viewOf(site, title, crumbs) {
    var made = new Object();
    made.site = site;
    made.title = title;
    made.crumbs = crumbs;
    return made;
}

// The form a POST sent, or null where its token against cross-site request forgery is not the one the browser keeps.
export async function formOf(request) {
    if (!(await request.checkCsrf())) {
        return null;
    }
    return await request.form();
}

// A field of a form, trimmed, or "" where it is not there.
export function fieldOf(form, name) {
    return (form?[name] ?? "").trim();
}

// The trail of links above a page of a board's: its category, then the board.
export function boardCrumbs(board) {
    return [[board["category_name"], $"/#category-{board['category_id']}"], [board["name"], $"/board?id={board['id']}"]];
}

// The trail of links above a page of a topic's: its category, its board, then the topic.
export function topicCrumbs(topic) {
    return [[topic["category_name"], $"/#category-{topic['category_id']}"], [topic["board_name"], $"/board?id={topic['board_id']}"],
            [topic["title"], $"/topic?id={topic['id']}"]];
}

// A page refused, with its status and why, a text's name, and its title, where it has another.
export function refuse(page, response, status, why, title = null) {
    response.status = status;
    if (title != null) {
        page.title = page.site.t(title);
    }
    page.refused = why;
    return page;
}

// Sends a reader not signed in to sign in first, then back to a path; gives whether it did.
export function signInFirst(site, response, back) {
    if (site.user != null) {
        return false;
    }
    redirect(response, "/account/sign-in?back=" + back);
    return true;
}

// Sends the browser on to a path, 303 See Other, as a form's answer does.
export function redirect(response, path) {
    response.status = 303;
    response.headers["Location"] = path;
}

// A path a link gives to come back to, if it is one of the forum's own: a path from its root, of plain characters;
// else the front page.
export function backOf(text) {
    if (!(text is String) || !text.startsWith("/") || text.startsWith("//") || text.length > 200) {
        return "/";
    }
    foreach (var c in text) {
        if (!"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789/?=&-_.".contains(c)) {
            return "/";
        }
    }
    return text;
}

// Where a request is, as a link back to it gives it: its path, and its id and page where the query gives them.
export function hereOf(request) {
    var id = idOf(request.query?["id"]);
    var page = idOf(request.query?["page"]);
    var query = id == null ? "" : $"?id={id}";
    if (page != null) {
        query = query + (query == "" ? "?" : "&") + $"page={page}";
    }
    return backOf(request.path + query);
}

// A positive integer from a query's text, or null where it is not one.
export function idOf(text) {
    if (text == null || text.length == 0 || text.length > 18) {
        return null;
    }
    foreach (var c in text) {
        if (!"0123456789".contains(c)) {
            return null;
        }
    }
    var value = Integer.parse(text);
    return value > 0 ? value : null;
}

// The page a query asks for, from 1, and the number of pages a count of items fills.
export function pageOf(text) {
    return idOf(text) ?? 1;
}
export function pagesOf(count, perPage) {
    return count == 0 ? 1 : (count + perPage - 1) \ perPage;
}
