// What differs in SQL between the forum's four databases, SQLite, SQL Server, MySQL and PostgreSQL, chosen by a
// database's provider, db.provider (Documents/weblingo-forum.md, section 3.3). Everything else the forum asks of a
// database is SQL that all four share, its names in lower case.

// Each kind of column in each database's own DDL: an identity, which is its table's key; an integer; a Boolean; a short
// text of at most @size characters; a long text; and a date, an instant, to the millisecond.
const types = {
    "sqlite": { "id": "INTEGER PRIMARY KEY", "integer": "INTEGER", "boolean": "BOOLEAN", "string": "TEXT", "text": "TEXT",
                "date": "DATETIME" },
    "sqlserver": { "id": "BIGINT IDENTITY(1, 1) PRIMARY KEY", "integer": "BIGINT", "boolean": "BIT", "string": "NVARCHAR(@size)",
                   "text": "NVARCHAR(MAX)", "date": "DATETIMEOFFSET(3)" },
    "mysql": { "id": "BIGINT AUTO_INCREMENT PRIMARY KEY", "integer": "BIGINT", "boolean": "BOOLEAN", "string": "VARCHAR(@size)",
               "text": "MEDIUMTEXT", "date": "DATETIME(3)" },
    "postgresql": { "id": "BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY", "integer": "BIGINT", "boolean": "BOOLEAN",
                    "string": "VARCHAR(@size)", "text": "TEXT", "date": "TIMESTAMPTZ(3)" }
};

// The providers the forum runs on.
export const providers = ["sqlite", "sqlserver", "mysql", "postgresql"];

// A column's type in the provider's DDL; size is a short text's length.
export function columnType(provider, type, size = null) {
    if (!types.has(provider)) {
        throw new Error($"The forum does not run on the database '{provider}'.");
    }
    var kinds = types[provider];
    if (!kinds.has(type)) {
        throw new Error($"'{type}' is not a kind of column of the forum's.");
    }
    return type == "string" ? kinds[type].replace("@size", $"{size}") : kinds[type];
}

// The clause that ends a query ordered by its ORDER BY, giving @count rows after skipping @skip of them.
export function page(provider) {
    return provider == "sqlserver" ? "OFFSET @skip ROWS FETCH NEXT @count ROWS ONLY" : "LIMIT @count OFFSET @skip";
}

// Inserts a row into a table, its values a map from its columns' names to their values, and gives the new row's id.
export async function insert(db, table, values) {
    var names = [];
    var holes = [];
    foreach (var (name, value) in values) {
        names.push(name);
        holes.push("@" + name);
    }
    var columns = ", ".join(names);
    var given = ", ".join(holes);
    if (db.provider == "sqlserver") {
        return (await db.query($"INSERT INTO {table} ({columns}) OUTPUT INSERTED.id VALUES ({given})", values))[0]["id"];
    }
    if (db.provider == "mysql") {
        await db.execute($"INSERT INTO {table} ({columns}) VALUES ({given})", values);
        return (await db.query("SELECT CAST(LAST_INSERT_ID() AS SIGNED) AS id"))[0]["id"];
    }
    return (await db.query($"INSERT INTO {table} ({columns}) VALUES ({given}) RETURNING id", values))[0]["id"];
}
