// The forum's tables, described once and written as each database's own DDL (Documents/weblingo-forum.md, section 3.3).
// setup.wlg makes them, and a later version of the forum upgrades a database to its version, step by step.

import { columnType } from "./sql.wlg";

// The schema's version, which the table schema_version holds: 1, the forum's first part's; 2, its members' tokens and
// failed sign-ins; 3, what each member has read, and the topics they watch; 4, each board's permissions for each group,
// bans, reports and the moderation log; 5, private messages.
export const version = 5;

function id() { return { name: "id", type: "id", nullable: false }; }
function integer(name) { return { name: name, type: "integer", nullable: false }; }
function boolean(name) { return { name: name, type: "boolean", nullable: false }; }
function string(name, size) { return { name: name, type: "string", size: size, nullable: false }; }
function text(name) { return { name: name, type: "text", nullable: false }; }
function date(name) { return { name: name, type: "date", nullable: false }; }
function optional(column) { return { ...column, nullable: true }; }

// Each table, in the order they are made, a table after those it refers to: its columns; its key, where it is not an
// identity's; the tables its columns refer to; its indexes; and the schema's version that added it, 1 where it says none.
export const tables = [
    { name: "schema_version", columns: [integer("version")] },
    { name: "settings", columns: [string("name", 100), text("value")], key: ["name"] },
    { name: "users", columns: [
        id(), string("name", 40), string("name_key", 40), string("email", 254), string("email_key", 254),
        string("password_hash", 200), date("created_at"), optional(date("confirmed_at")), optional(string("time_zone", 64)),
        optional(string("language", 16)), optional(text("signature")), integer("post_count"), optional(date("last_seen_at"))],
      indexes: [{ name: "users_name_key", columns: ["name_key"], unique: true },
                { name: "users_email_key", columns: ["email_key"], unique: true }] },
    { name: "member_groups", columns: [id(), string("name", 60), optional(string("kind", 20))] },
    { name: "group_members", columns: [integer("group_id"), integer("user_id")], key: ["group_id", "user_id"],
      references: { "group_id": "member_groups", "user_id": "users" },
      indexes: [{ name: "group_members_user", columns: ["user_id"], unique: false }] },
    { name: "categories", columns: [id(), string("name", 100), integer("sort_order")] },
    { name: "boards", columns: [
        id(), integer("category_id"), string("name", 100), optional(string("description", 500)), integer("sort_order"),
        integer("topic_count"), integer("post_count"), optional(integer("last_post_id"))],
      references: { "category_id": "categories" },
      indexes: [{ name: "boards_category", columns: ["category_id", "sort_order"], unique: false }] },
    { name: "topics", columns: [
        id(), integer("board_id"), integer("user_id"), string("title", 200), date("created_at"), integer("post_count"),
        integer("view_count"), optional(integer("last_post_id")), date("last_post_at"), boolean("pinned"), boolean("locked"),
        boolean("deleted")],
      references: { "board_id": "boards", "user_id": "users" },
      indexes: [{ name: "topics_board", columns: ["board_id", "pinned", "last_post_at"], unique: false }] },
    { name: "posts", columns: [
        id(), integer("topic_id"), integer("user_id"), text("body"), date("created_at"), optional(date("edited_at")),
        optional(integer("edited_by")), boolean("deleted")],
      references: { "topic_id": "topics", "user_id": "users" },
      indexes: [{ name: "posts_topic", columns: ["topic_id", "id"], unique: false },
                { name: "posts_user", columns: ["user_id"], unique: false }] },
    // A link's token mailed to a member, to confirm their address or reset their password: kept only as its hash, used once.
    { name: "tokens", since: 2, columns: [
        id(), integer("user_id"), string("kind", 20), string("token_hash", 64), date("created_at"), date("expires_at"),
        optional(date("used_at"))],
      references: { "user_id": "users" },
      indexes: [{ name: "tokens_hash", columns: ["token_hash"], unique: true }] },
    // A failed sign-in to a member's account, which too many of in a short time make the next wait.
    { name: "sign_in_failures", since: 2, columns: [id(), integer("user_id"), date("failed_at")],
      references: { "user_id": "users" },
      indexes: [{ name: "sign_in_failures_user", columns: ["user_id", "failed_at"], unique: false }] },
    // The last post of a topic a member has read.
    { name: "topic_reads", since: 3, columns: [integer("user_id"), integer("topic_id"), integer("last_read_post_id")],
      key: ["user_id", "topic_id"], references: { "user_id": "users", "topic_id": "topics" } },
    // A topic a member watches, mailed of its next reply; notified until they read it again, so that they get one mail.
    { name: "topic_watches", since: 3, columns: [integer("user_id"), integer("topic_id"), boolean("notified")],
      key: ["user_id", "topic_id"], references: { "user_id": "users", "topic_id": "topics" },
      indexes: [{ name: "topic_watches_topic", columns: ["topic_id"], unique: false }] },
    // What a group may do on a board: see it, read it, start topics, reply, edit and delete its members' own posts, and
    // moderate it.
    { name: "board_permissions", since: 4, columns: [
        integer("board_id"), integer("group_id"), boolean("can_see"), boolean("can_read"), boolean("can_start"),
        boolean("can_reply"), boolean("can_edit"), boolean("can_delete"), boolean("can_moderate")],
      key: ["board_id", "group_id"], references: { "board_id": "boards", "group_id": "member_groups" } },
    // A member banned by a moderator, until a time, or for good where it has none, and why; lifted, where it ended early.
    { name: "bans", since: 4, columns: [
        id(), integer("user_id"), optional(date("ends_at")), optional(string("reason", 500)), date("created_at"),
        integer("created_by"), optional(date("lifted_at"))],
      references: { "user_id": "users" },
      indexes: [{ name: "bans_user", columns: ["user_id"], unique: false }] },
    // A post a member reported to the moderators, and why; resolved, where a moderator dealt with it.
    { name: "reports", since: 4, columns: [
        id(), integer("post_id"), integer("user_id"), string("reason", 500), date("created_at"), optional(date("resolved_at")),
        optional(integer("resolved_by"))],
      references: { "post_id": "posts", "user_id": "users" },
      indexes: [{ name: "reports_post", columns: ["post_id"], unique: false }] },
    // Each of a moderator's actions: who, what, on which topic, post or member, with what, and when.
    { name: "moderation_log", since: 4, columns: [
        id(), integer("user_id"), string("action", 30), optional(integer("topic_id")), optional(integer("post_id")),
        optional(integer("member_id")), optional(string("details", 500)), date("created_at")],
      references: { "user_id": "users" },
      indexes: [{ name: "moderation_log_time", columns: ["created_at"], unique: false }] },
    // A conversation of members' private messages: its subject, who began it and when, and its latest message.
    { name: "conversations", since: 5, columns: [
        id(), string("subject", 200), integer("created_by"), date("created_at"), optional(integer("last_message_id")),
        date("last_message_at")],
      references: { "created_by": "users" } },
    // A member of a conversation, and the last of its messages they have read, 0 for none.
    { name: "conversation_members", since: 5, columns: [integer("conversation_id"), integer("user_id"), integer("last_read_id")],
      key: ["conversation_id", "user_id"], references: { "conversation_id": "conversations", "user_id": "users" },
      indexes: [{ name: "conversation_members_user", columns: ["user_id"], unique: false }] },
    // A private message: its conversation, who wrote it and when, and its Markdown.
    { name: "messages", since: 5, columns: [id(), integer("conversation_id"), integer("user_id"), text("body"), date("created_at")],
      references: { "conversation_id": "conversations", "user_id": "users" },
      indexes: [{ name: "messages_conversation", columns: ["conversation_id", "id"], unique: false }] }
];

// The schema's version that added a table.
function sinceOf(table) {
    return table?["since"] ?? 1;
}

// The statements that make a table and its indexes in the provider's DDL.
export function createTable(provider, table) {
    var parts = [];
    foreach (var column in table["columns"]) {
        var type = columnType(provider, column["type"], column?["size"]);
        parts.push(column["type"] == "id" ? $"{column['name']} {type}"
                                         : $"{column['name']} {type} {(column['nullable'] ? 'NULL' : 'NOT NULL')}");
    }
    if (table.has("key")) {
        parts.push($"PRIMARY KEY ({', '.join(table['key'])})");
    }
    if (table.has("references")) {
        foreach (var (name, target) in table["references"]) {
            parts.push($"FOREIGN KEY ({name}) REFERENCES {target} (id)");
        }
    }
    var statements = [$"CREATE TABLE {table['name']} ({', '.join(parts)})"];
    if (table.has("indexes")) {
        foreach (var index in table["indexes"]) {
            var unique = index["unique"] ? "UNIQUE " : "";
            statements.push($"CREATE {unique}INDEX {index['name']} ON {table['name']} ({', '.join(index['columns'])})");
        }
    }
    return statements;
}

// Every statement that makes the schema, in order, in the provider's DDL: the whole of it, or that of a version.
export function create(provider, upTo = version) {
    var statements = [];
    foreach (var table in tables) {
        if (sinceOf(table) <= upTo) {
            foreach (var statement in createTable(provider, table)) {
                statements.push(statement);
            }
        }
    }
    return statements;
}

// The statements that upgrade a database's schema from a version to this one, in the provider's DDL: the tables added
// since.
export function upgrade(provider, from) {
    var statements = [];
    foreach (var table in tables) {
        if (sinceOf(table) > from) {
            foreach (var statement in createTable(provider, table)) {
                statements.push(statement);
            }
        }
    }
    return statements;
}

// The version of the schema a database holds: 0 where it holds none of the forum's tables.
export async function versionOf(db) {
    try {
        var rows = await db.query("SELECT version FROM schema_version");
        return rows.length == 0 ? 0 : rows[0]["version"];
    } catch (DatabaseError e) {
        return 0;
    }
}
