// The forum's topics and their posts, as the database holds them.

import { Shared } from "std:shared";
import { DateTime } from "std:datetime";
import { page } from "./sql.wlg";

// How many topics a board shows, those deleted left out.
export async function countOnBoard(db, board) {
    return (await db.query("SELECT COUNT(*) AS n FROM topics WHERE board_id = @board AND deleted = @deleted",
                           { board: board, deleted: false }))[0]["n"];
}

// A page of a board's topics, the pinned first, then those whose latest post is the latest, each with its author's name,
// its latest post's author's, and the last of its posts a member saw, last_read, null where they saw none, or for user 0.
export async function onBoard(db, board, user, skip, count) {
    return withUnwritten(await db.query($"""
        SELECT t.id, t.title, t.post_count, t.view_count, t.pinned, t.locked, t.created_at, t.last_post_id, t.last_post_at,
               u.name AS user_name, l.name AS last_post_by, r.last_read_post_id AS last_read
        FROM topics t
        LEFT JOIN users u ON u.id = t.user_id
        LEFT JOIN posts p ON p.id = t.last_post_id
        LEFT JOIN users l ON l.id = p.user_id
        LEFT JOIN topic_reads r ON r.topic_id = t.id AND r.user_id = @user
        WHERE t.board_id = @board AND t.deleted = @deleted
        ORDER BY t.pinned DESC, t.last_post_at DESC, t.id DESC
        {page(db.provider)}
        """, { board: board, user: user, deleted: false, skip: skip, count: count }));
}

// A topic, with its board's and its category's ids and names, or null where there is none of that id, or it is deleted,
// unless deleted is true.
export async function one(db, id, deleted = false) {
    if (id == null) {
        return null;
    }
    var rows = await db.query($"""
        SELECT t.id, t.title, t.post_count, t.view_count, t.pinned, t.locked, t.created_at, t.user_id, t.last_post_id,
               t.last_post_at, t.deleted,
               b.id AS board_id, b.name AS board_name, c.id AS category_id, c.name AS category_name
        FROM topics t JOIN boards b ON b.id = t.board_id JOIN categories c ON c.id = b.category_id
        WHERE t.id = @id{(deleted ? "" : " AND t.deleted = @deleted")}
        """, { id: id, deleted: false });
    return rows.length == 0 ? null : withUnwritten(rows)[0];
}

// How many posts a topic shows, those deleted left out.
export async function countOfPosts(db, topic) {
    return (await db.query("SELECT COUNT(*) AS n FROM posts WHERE topic_id = @topic AND deleted = @deleted",
                           { topic: topic, deleted: false }))[0]["n"];
}

// A page of a topic's posts, in order, each with its author's name, when they joined, how many posts they have, their
// signature, and their avatar's id, or null.
export async function posts(db, topic, skip, count) {
    return await db.query($"""
        SELECT p.id, p.body, p.created_at, p.edited_at, p.user_id,
               u.name AS user_name, u.created_at AS user_joined, u.post_count AS user_posts, u.signature AS user_signature,
               (SELECT MAX(a.id) FROM uploads a WHERE a.user_id = p.user_id AND a.kind = @avatar) AS user_avatar
        FROM posts p LEFT JOIN users u ON u.id = p.user_id
        WHERE p.topic_id = @topic AND p.deleted = @deleted
        ORDER BY p.id
        {page(db.provider)}
        """, { topic: topic, deleted: false, skip: skip, count: count, avatar: "avatar" });
}

// How many views of a topic are counted in the memory the site's requests share before they are written to its
// database, all at once; and how many seconds after the first of them they are written, however few
// (Documents/weblingo-forum.md, section 2, "Reading").
export const viewsWritten = 20;
export const viewsWait = 60;

// The key a topic's views not yet written are counted under in the shared memory, and the one that keeps when the first
// of them was counted.
export function viewsKey(topic) {
    return "forum:views:" + topic.toString();
}

function viewsSinceKey(topic) {
    return "forum:views-since:" + topic.toString();
}

// Counts a topic's view, at now, in the memory the site's requests share, so that a view writes nothing of its own: its
// views written at once once viewsWritten have been counted, or viewsWait seconds after the first of them, at the view
// that comes then; those not yet written lost where the site's process stops.
export async function viewed(db, topic, now = DateTime.now()) {
    var count = Shared.add(viewsKey(topic), 1);
    if (count == 1) {
        Shared.set(viewsSinceKey(topic), now);
    }
    var since = Shared.get(viewsSinceKey(topic));
    if (count >= viewsWritten || since == null || now - since >= viewsWait * 1000) {
        await writeViews(db, topic);
    }
}

// Writes the views of a topic counted so far, taken from the shared memory in one step, so that no other request writes
// them too; counted again, for the next view to write, where the database fails.
export async function writeViews(db, topic) {
    var taken = Shared.take(viewsKey(topic));
    if (taken == null) {
        return;
    }
    Shared.remove(viewsSinceKey(topic));
    try {
        await db.execute("UPDATE topics SET view_count = view_count + @views WHERE id = @id", { views: taken, id: topic });
    } catch (e) {
        Shared.add(viewsKey(topic), taken);
        throw;
    }
}

// How many views of a topic are counted and not yet written.
export function unwritten(topic) {
    return Shared.get(viewsKey(topic)) ?? 0;
}

// Topics' rows, each view_count the views written and those not yet.
function withUnwritten(rows) {
    foreach (var row in rows) {
        row["view_count"] = row["view_count"] + unwritten(row["id"]);
    }
    return rows;
}

// The cookie of the forum's own that holds the topics a reader's browser has had a view counted of, their ids, the oldest
// first, a session cookie, its path the topic pages', so that a reader's session stays read only on a topic's page.
export const viewsCookie = "viewed";

// How many topics the cookie remembers, the oldest forgotten first.
export const viewsRemembered = 300;

// The most its value may hold, so that the cookie stays under the 4,096 bytes a browser keeps of one (RFC 6265, section 6.1).
export const viewsLength = 3800;

// Words a known crawler's User-Agent has, compared without case: Googlebot's and Bingbot's, Yahoo's Slurp, AdSense's, and
// what fetches a link's preview for Facebook.
const crawlers = ["bot", "crawler", "spider", "slurp", "mediapartners", "facebookexternalhit"];

// Whether a request is a known crawler's, by its User-Agent.
export function isCrawler(request) {
    var agent = request.headers.has("User-Agent") ? request.headers["User-Agent"].toLower() : "";
    return crawlers.any(word => agent.contains(word));
}

// The topics a request's cookie says have had a view counted, the oldest first; what is not a topic's id left out, the
// cookie being unsigned, so that a changed or a cleared one only counts a view again, or not at all.
export function counted(request) {
    var seen = [];
    foreach (var part in (request.cookies?[viewsCookie] ?? "").split(".")) {
        try {
            var id = Integer.parse(part);
            if (id > 0 && !seen.contains(id)) {
                seen.push(id);
            }
        } catch (e) {
            // Not a topic's id.
        }
    }
    return seen;
}

// Whether a request's view of a topic is counted (Documents/weblingo-forum.md, section 2, "Reading"): its board counts
// views, the request is no known crawler's, and its reader's browser has not had a view of the topic counted yet, which
// the cookie remembers then, so that a reader reading a topic again writes nothing.
export function counts(settings, request, response, topic) {
    if (settings["boardsWithoutViews"].contains(topic["board_id"]) || isCrawler(request)) {
        return false;
    }
    var seen = counted(request);
    if (seen.contains(topic["id"])) {
        return false;
    }
    seen.push(topic["id"]);
    var text = seen.map(id => id.toString()).join(".");
    while (seen.length > viewsRemembered || text.length > viewsLength) {
        seen = seen.slice(1, seen.length);
        text = seen.map(id => id.toString()).join(".");
    }
    response.setCookie(viewsCookie, text, { path: "/topic" });
    return true;
}
