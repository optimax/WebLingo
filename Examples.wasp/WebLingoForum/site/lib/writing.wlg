// What the writing pages do, and show (Documents/weblingo-forum.md, section 2, "Topics and posts"; section 6, part 3):
// starting a topic, replying, quoting, and editing and deleting one's own posts, each that writes with a preview first,
// if asked for; and watching a topic. Each page's work runs once for each request, from its layout's values, before
// anything is written, so that a page sent on, or refused, shows so.

import { DateTime } from "std:datetime";
import { begin, open, viewOf, formOf, redirect, idOf, boardCrumbs, topicCrumbs, refuse, signInFirst } from "./forum.wlg";
import boards from "./boards.wlg";
import topics from "./topics.wlg";
import posts from "./posts.wlg";
import reading from "./reading.wlg";
import moderation from "./moderation.wlg";
import { escape, quote } from "./markdown.wlg";
import { sendReplies } from "./mail.wlg";
import uploads from "./uploads.wlg";

// A writing page's view: what its form holds, what is wrong with it, its preview, and, where the page is refused, why,
// a text's name.
function view(site, title, crumbs) {
    var page = viewOf(site, title, crumbs);
    page.values = { title: "", body: "" };
    page.problems = [];
    page.preview = null;
    page.refused = null;
    page.done = false;
    page.files = uploads.offered(site.settings, []);
    page.checked = [];
    return page;
}

// A post's text as HTML, its images as the forum's settings allow them, through the plugins' filter.
async function htmlOf(site, body) {
    return await site.html(body, "post");
}

// The form a page posted, with its text and its title, where it has one, kept as they are kept, its files checked,
// the post keeping kept of its own, and what is wrong with them; or null where its token against cross-site request
// forgery is not the browser's, the page then refused. A preview keeps no file: they are chosen again to be posted.
async function postedTo(page, request, response, titled, kept = 0) {
    var form = await formOf(request);
    if (form == null) {
        response.status = 400;
        page.problems.push("form.expired");
        return null;
    }
    page.values = { title: titled ? posts.titleOf(form?["title"]) : page.values["title"], body: posts.bodyOf(form?["body"]) };
    if (form?["action"] == "preview") {
        page.preview = await htmlOf(page.site, page.values["body"]);
    } else {
        foreach (var problem in [titled ? posts.titleProblem(page.values["title"]) : null, posts.bodyProblem(page.values["body"])]) {
            if (problem != null) {
                page.problems.push(problem);
            }
        }
        var files = await uploads.posted(page.site.settings, request, kept);
        page.checked = files.checked;
        foreach (var problem in files.problems) {
            page.problems.push(problem);
        }
        if (page.problems.length > 0) {
            response.status = 400;
        }
    }
    return form;
}

// A post's files, checked, kept as its attachments, its writer's.
async function attach(db, page, post) {
    foreach (var checked in page.checked) {
        await uploads.keep(db, checked, "attachment", page.site.user["id"], post, DateTime.utcNow());
    }
}

// /post/new?board=1: a new topic on a board whose groups let the member start one, its title and its first post, which
// its author then watches.
export async function newTopicPage(request, response) {
    var site = await begin(request);
    return await site.once("newTopic", async () => {
        using (var db = await open()) {
            var board = await boards.one(db, idOf(request.query?["board"]));
            var page = view(site, site.t("post.newTopic"), board == null ? [] : boardCrumbs(board));
            if (board == null || !site.can(board["id"], "see")) {
                page.crumbs = [];
                return refuse(page, response, 404, "forum.notFoundText", "board.notFound");
            }
            page.action = $"/post/new?board={board['id']}";
            if (signInFirst(site, response, page.action)) {
                return page;
            }
            if (!posts.mayStart(site, board["id"])) {
                return refuse(page, response, 403, "post.mayNotStart");
            }
            if (request.method != "POST") {
                return page;
            }
            var form = await postedTo(page, request, response, true);
            if (form == null || page.preview != null || page.problems.length > 0) {
                return page;
            }
            var made = await posts.start(db, board["id"], site.user["id"], page.values["title"], page.values["body"], DateTime.utcNow());
            await attach(db, page, made["post"]);
            await site.hooks.run("post.created", { post: made["post"], topic: made["topic"], user: site.user["id"] });
            await reading.saw(db, site.user["id"], made["topic"], made["post"]);
            await reading.watch(db, site.user["id"], made["topic"]);
            page.done = true;
            redirect(response, $"/topic?id={made['topic']}");
            return page;
        }
    });
}

// /post/reply?topic=42, and &quote=7 to begin with a post quoted: a reply to a topic, by a member whose groups may reply
// on its board, while it is not locked, unless they moderate the board; mailed to those who watch it.
export async function replyPage(request, response) {
    var site = await begin(request);
    return await site.once("reply", async () => {
        using (var db = await open()) {
            var topic = await topics.one(db, idOf(request.query?["topic"]));
            if (topic != null && !site.can(topic["board_id"], "read")) {
                topic = null;
            }
            var page = view(site, site.t("post.reply"), topic == null ? [] : topicCrumbs(topic));
            page.topic = topic;
            if (topic == null) {
                return refuse(page, response, 404, "forum.notFoundText", "topic.notFound");
            }
            page.action = $"/post/reply?topic={topic['id']}";
            if (signInFirst(site, response, $"/topic?id={topic['id']}")) {
                return page;
            }
            if (!posts.mayReply(site, topic)) {
                return refuse(page, response, 403, site.can(topic["board_id"], "reply") ? "topic.locked" : "post.mayNotReply");
            }
            if (request.method != "POST") {
                var quoted = await posts.one(db, idOf(request.query?["quote"]));
                if (quoted != null && quoted["topic_id"] == topic["id"]) {
                    var name = escape(quoted["user_name"] ?? site.t("user.deleted"));
                    page.values["body"] = quote(site.f("post.quoteWrote", { name: name }), quoted["body"]);
                }
                return page;
            }
            var form = await postedTo(page, request, response, false);
            if (form == null || page.preview != null || page.problems.length > 0) {
                return page;
            }
            var post = await posts.reply(db, topic, site.user["id"], page.values["body"], DateTime.utcNow());
            await attach(db, page, post);
            await site.hooks.run("post.created", { post: post, topic: topic["id"], user: site.user["id"] });
            await reading.saw(db, site.user["id"], topic["id"], post);
            await sendReplies(db, site, request, topic, site.user);
            page.done = true;
            redirect(response, await posts.linkOf(db, topic["id"], post, site.settings["postsPerPage"]));
            return page;
        }
    });
}

// A post a page changes, /post/edit?id=7 or /post/delete?id=7, and its topic; refused where there is none the reader may
// read, or where they may not change it: their own, as their groups let them, or another's on a board they moderate.
async function changed(db, site, request, response, page, action) {
    var post = await posts.one(db, idOf(request.query?["id"]));
    var topic = post == null ? null : await topics.one(db, post["topic_id"]);
    if (topic != null && !site.can(topic["board_id"], "read")) {
        topic = null;
    }
    page.post = post;
    page.topic = topic;
    if (topic == null) {
        refuse(page, response, 404, "forum.notFoundText", "post.notFound");
        return false;
    }
    page.crumbs = topicCrumbs(topic);
    page.action = $"/post/{action}?id={post['id']}";
    if (signInFirst(site, response, page.action)) {
        return false;
    }
    page.first = await posts.firstOf(db, topic["id"]);
    if (action == "edit" ? posts.mayEdit(site, topic, post) : posts.mayDelete(site, topic, post, page.first)) {
        return true;
    }
    var why = "post.notAllowed";
    if (action == "delete" && post["id"] == page.first && topic["post_count"] > 1) {
        why = "post.firstWithReplies";
    } else if (post["user_id"] != site.user["id"]) {
        why = "post.notYours";
    } else if (topic["locked"]) {
        why = "post.locked";
    }
    refuse(page, response, 403, why);
    return false;
}

// /post/edit?id=7: a post, its text, its topic's title where it is the topic's first, and its files, those ticked
// removed, others added; a moderator's edit of another's post logged.
export async function editPage(request, response) {
    var site = await begin(request);
    return await site.once("edit", async () => {
        using (var db = await open()) {
            var page = view(site, site.t("post.edit"), []);
            if (!(await changed(db, site, request, response, page, "edit"))) {
                return page;
            }
            page.titled = page.post["id"] == page.first;
            page.values = { title: page.topic["title"], body: page.post["body"] };
            var attached = await uploads.ofPost(db, page.post["id"]);
            page.files = uploads.offered(site.settings, attached);
            if (request.method != "POST") {
                return page;
            }
            var given = await request.form();
            var removed = attached.filter(file => (given?[$"remove.{file['id']}"] ?? "") != "");
            var form = await postedTo(page, request, response, page.titled, attached.length - removed.length);
            if (form == null || page.preview != null || page.problems.length > 0) {
                return page;
            }
            var now = DateTime.utcNow();
            await posts.edit(db, page.post, page.values["body"], page.titled ? page.values["title"] : null, site.user["id"], now);
            foreach (var file in removed) {
                await uploads.remove(db, await uploads.one(db, file["id"]));
            }
            await attach(db, page, page.post["id"]);
            if (page.post["user_id"] != site.user["id"]) {
                await moderation.log(db, site.user["id"], "editPost", { topic: page.topic["id"], post: page.post["id"] }, now);
            }
            page.done = true;
            redirect(response, await posts.linkOf(db, page.topic["id"], page.post["id"], site.settings["postsPerPage"]));
            return page;
        }
    });
}

// /post/delete?id=7: a post, deleted once the reader says so; a topic's first only where it is its only one, the topic
// deleted with it; a moderator's deletion of another's post logged.
export async function deletePage(request, response) {
    var site = await begin(request);
    return await site.once("delete", async () => {
        using (var db = await open()) {
            var page = view(site, site.t("post.delete"), []);
            if (!(await changed(db, site, request, response, page, "delete"))) {
                return page;
            }
            page.html = await htmlOf(site, page.post["body"]);
            page.alone = page.topic["post_count"] == 1;
            if (request.method != "POST") {
                return page;
            }
            if (await formOf(request) == null) {
                response.status = 400;
                page.problems.push("form.expired");
                return page;
            }
            var gone = await posts.remove(db, page.post, page.topic);
            if (page.post["user_id"] != site.user["id"]) {
                await moderation.log(db, site.user["id"], "deletePost", { topic: page.topic["id"], post: page.post["id"] }, DateTime.utcNow());
            }
            page.done = true;
            redirect(response, gone ? $"/board?id={page.topic['board_id']}" : $"/topic?id={page.topic['id']}");
            return page;
        }
    });
}

// /post/watch, posted by a topic's button: the member watches the topic, or stops watching it, and is sent back to it.
export async function watchPosted(request, response) {
    var site = await begin(request);
    var form = await formOf(request);
    var topic = idOf(form?["topic"]);
    if (site.user != null && topic != null) {
        using (var db = await open()) {
            var row = await topics.one(db, topic);
            if (row != null && site.can(row["board_id"], "read")) {
                if (form?["action"] == "unwatch") {
                    await reading.unwatch(db, site.user["id"], topic);
                } else {
                    await reading.watch(db, site.user["id"], topic);
                }
            }
        }
    }
    redirect(response, topic == null ? "/" : $"/topic?id={topic}");
}
