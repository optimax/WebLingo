// The forum's members: what a name, an address and a password must be, and making, finding and changing a member.

import crypto from "std:crypto";
import { Regex } from "std:regex";
import { insert, page } from "./sql.wlg";

// A name: 2 to 40 letters and digits of any script, with spaces, dots, hyphens and underscores between them.
const namePattern = new Regex("^[\\p{L}\\p{N}](?:[\\p{L}\\p{N} ._-]*[\\p{L}\\p{N}])?$");

// A password's hash that no password gives, checked where a sign-in names no member, so that a sign-in takes as long
// whether its name is a member's or not.
const noOnesHash = "pbkdf2-sha256$600000$k36HTS7vqmcq1w8HyNCb7Q==$Us51Q35SRUIK0NzKYikogHMe6WyYsKxa0QRUjgTdfT8=";

// The key a name or an address is unique by, whatever its case: two names that differ only by case are one name.
export function keyOf(text) {
    return text.trim().toLower();
}

// Why a name cannot be a member's, a text's name, or null where it can.
export function nameProblem(name) {
    if (!(name is String) || name.trim().length < 2) {
        return "user.nameTooShort";
    }
    if (name.trim().length > 40) {
        return "user.nameTooLong";
    }
    if (!namePattern.test(name.trim()) || name.trim().contains("  ")) {
        return "user.nameCharacters";
    }
    return null;
}

// Why an address cannot be a member's, a text's name, or null where it can: one @, something on either side of it, a
// dot after it, no spaces, at most 254 characters.
export function emailProblem(email) {
    if (!(email is String)) {
        return "user.emailInvalid";
    }
    var text = email.trim();
    var at = text.indexOf("@");
    if (text.length > 254 || at < 1 || at != text.lastIndexOf("@") || text.contains(" ")
        || !text.slice(at + 1).contains(".") || text.endsWith(".")) {
        return "user.emailInvalid";
    }
    return null;
}

// Why a password cannot be a member's, a text's name, or null where it can: 8 to 200 characters.
export function passwordProblem(password) {
    if (!(password is String) || password.length < 8) {
        return "user.passwordTooShort";
    }
    if (password.length > 200) {
        return "user.passwordTooLong";
    }
    return null;
}

// A password's hash, as the database keeps it, made off the worker.
export async function hash(password) {
    return await crypto.hashPasswordAsync(password);
}

// Whether a password is the one a hash was made of; a hash of null checks the password against no one's, false.
export async function verify(password, passwordHash) {
    var matches = await crypto.verifyPasswordAsync(password, passwordHash ?? noOnesHash);
    return matches && passwordHash != null;
}

// Makes a member, its name and address checked by the caller, given its password's hash, and gives its id. confirmed
// is when its address was confirmed, or null.
export async function make(db, name, email, passwordHash, now, confirmed) {
    return await insert(db, "users", {
        name: name.trim(), name_key: keyOf(name), email: email.trim(), email_key: keyOf(email),
        password_hash: passwordHash, created_at: now, confirmed_at: confirmed,
        time_zone: null, language: null, signature: null, post_count: 0, last_seen_at: null
    });
}

// Puts a member in the group of a kind: "members", "moderators" or "administrators".
export async function join(db, user, kind) {
    await db.execute("INSERT INTO group_members (group_id, user_id) SELECT id, @user FROM member_groups WHERE kind = @kind",
                     { user: user, kind: kind });
}

const columns = "id, name, email, password_hash, created_at, confirmed_at, time_zone, language, signature, post_count, last_seen_at";

// The member of an id, a name's key or an address's key, or null.
export async function byId(db, id) {
    var rows = await db.query($"SELECT {columns} FROM users WHERE id = @id", { id: id });
    return rows.length == 0 ? null : rows[0];
}
export async function byName(db, key) {
    var rows = await db.query($"SELECT {columns} FROM users WHERE name_key = @key", { key: key });
    return rows.length == 0 ? null : rows[0];
}
export async function byEmail(db, key) {
    var rows = await db.query($"SELECT {columns} FROM users WHERE email_key = @key", { key: key });
    return rows.length == 0 ? null : rows[0];
}

// The member a name or an address, as someone signing in gives it, names.
export async function byNameOrEmail(db, text) {
    var key = keyOf(text);
    return key.contains("@") ? await byEmail(db, key) : await byName(db, key);
}

// Changes a member's password, given its new hash.
export async function setPassword(db, user, passwordHash) {
    await db.execute("UPDATE users SET password_hash = @hash WHERE id = @id", { hash: passwordHash, id: user });
}

// How many members have confirmed their addresses, and a page of them, by name.
export async function count(db) {
    return (await db.query("SELECT COUNT(*) AS n FROM users WHERE confirmed_at IS NOT NULL"))[0]["n"];
}
export async function list(db, skip, count) {
    return await db.query($"""
        SELECT id, name, created_at, post_count, last_seen_at FROM users WHERE confirmed_at IS NOT NULL
        ORDER BY name_key, id
        {page(db.provider)}
        """, { skip: skip, count: count });
}
