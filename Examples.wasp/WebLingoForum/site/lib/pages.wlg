// What each of the forum's pages shows, read from the database once for each request, so that a page and its layout
// share it: its title, the trail of links above it, and its own data, as an object's fields.

import { begin, open, viewOf, redirect, idOf, pageOf, pagesOf } from "./forum.wlg";
import boards from "./boards.wlg";
import topics from "./topics.wlg";
import posts from "./posts.wlg";
import reading from "./reading.wlg";
import users from "./users.wlg";

function view(site, title, crumbs) {
    return viewOf(site, title, crumbs);
}

// The page a query asks for, within the pages there are.
function pageWithin(request, pages) {
    var page = pageOf(request.query?["page"]);
    return page > pages ? pages : page;
}

// The front page: the categories and the boards the reader may see, a category without one left out.
export async function indexPage(request) {
    var site = await begin(request);
    return await site.once("index", async () => {
        var page = view(site, site.t("index.title"), []);
        page.categories = [];
        using (var db = await open()) {
            foreach (var category in await boards.index(db)) {
                category["boards"] = category["boards"].filter(board => site.can(board["id"], "see"));
                if (category["boards"].length > 0) {
                    page.categories.push(category);
                }
            }
        }
        return page;
    });
}

// A board's page, /board?id=3&page=2: the board, a page of its topics, each marked where it has posts new to the
// member, and the page numbers; its board null where the query names none the reader may see, and its topics none where
// they may not read it.
export async function boardPage(request) {
    var site = await begin(request);
    return await site.once("board", async () => {
        using (var db = await open()) {
            var board = await boards.one(db, idOf(request.query?["id"]));
            if (board == null || !site.can(board["id"], "see")) {
                var missing = view(site, site.t("board.notFound"), []);
                missing.board = null;
                return missing;
            }
            var page = view(site, board["name"], [[board["category_name"], $"/#category-{board['category_id']}"]]);
            var perPage = site.settings["topicsPerPage"];
            page.board = board;
            page.readable = site.can(board["id"], "read");
            if (!page.readable) {
                page.pages = 1;
                page.page = 1;
                page.topics = [];
                return page;
            }
            page.pages = pagesOf(await topics.countOnBoard(db, board["id"]), perPage);
            page.page = pageWithin(request, page.pages);
            page.topics = await topics.onBoard(db, board["id"], site.user?["id"] ?? 0, (page.page - 1) * perPage, perPage);
            foreach (var topic in page.topics) {
                topic["new"] = reading.isNew(site.user, topic);
            }
            return page;
        }
    });
}

// A topic's page, /topic?id=42&page=2: the topic, its first post's id, whether the member watches it, a page of its posts,
// and the page numbers, its view counted, and its posts kept as seen by the member; its topic null where the query names
// none the reader may read, a deleted one read by its board's moderators alone. For them, the boards they may move it
// to. With &unread=1, the member is sent on to the first post new to them, or to its last.
export async function topicPage(request, response) {
    var site = await begin(request);
    return await site.once("topic", async () => {
        using (var db = await open()) {
            var topic = await topics.one(db, idOf(request.query?["id"]), true);
            if (topic == null || !site.can(topic["board_id"], "read") || (topic["deleted"] && !site.can(topic["board_id"], "moderate"))) {
                var missing = view(site, site.t("topic.notFound"), []);
                missing.topic = null;
                return missing;
            }
            var page = view(site, topic["title"], [[topic["category_name"], $"/#category-{topic['category_id']}"],
                                                   [topic["board_name"], $"/board?id={topic['board_id']}"]]);
            var perPage = site.settings["postsPerPage"];
            page.topic = topic;
            page.firstPost = await posts.firstOf(db, topic["id"]);
            page.watching = site.user != null && await reading.isWatching(db, site.user["id"], topic["id"]);
            page.moderates = site.can(topic["board_id"], "moderate");
            page.boards = page.moderates ? (await boards.all(db)).filter(board => site.can(board["id"], "moderate")) : [];
            page.pages = 1;
            page.page = 1;
            page.first = 0;
            page.posts = [];
            if (site.user != null && request.query?["unread"] == "1") {
                var next = await reading.firstNew(db, site.user, topic["id"]);
                redirect(response, await posts.linkOf(db, topic["id"], next ?? topic["last_post_id"], perPage));
                return page;
            }
            page.pages = pagesOf(await topics.countOfPosts(db, topic["id"]), perPage);
            page.page = pageWithin(request, page.pages);
            page.first = (page.page - 1) * perPage;
            page.posts = await topics.posts(db, topic["id"], page.first, perPage);
            await topics.viewed(db, topic["id"]);
            if (site.user != null && page.posts.length > 0) {
                await reading.saw(db, site.user["id"], topic["id"], page.posts[page.posts.length - 1]["id"]);
            }
            return page;
        }
    });
}

// The members' page, /members?page=2: a page of the members, by name, and the page numbers.
export async function membersPage(request) {
    var site = await begin(request);
    return await site.once("members", async () => {
        var page = view(site, site.t("members.title"), []);
        var perPage = 50;
        using (var db = await open()) {
            page.pages = pagesOf(await users.count(db), perPage);
            page.page = pageWithin(request, page.pages);
            page.members = await users.list(db, (page.page - 1) * perPage, perPage);
        }
        return page;
    });
}

// A member's page, /members/member?id=3: their name, when they joined and were last seen, their posts and signature;
// its member null where the query names none, or one whose address is not confirmed.
export async function memberPage(request) {
    var site = await begin(request);
    return await site.once("member", async () => {
        using (var db = await open()) {
            var member = await users.byId(db, idOf(request.query?["id"]));
            if (member == null || member["confirmed_at"] == null) {
                var missing = view(site, site.t("member.notFound"), [[site.t("members.title"), "/members"]]);
                missing.member = null;
                return missing;
            }
            var page = view(site, member["name"], [[site.t("members.title"), "/members"]]);
            page.member = member;
            return page;
        }
    });
}
