<% param request; param response; import { confirmPage } from "/lib/accounts.wlg"; %>
<% layout "/layouts/main.wasp", { title: (await confirmPage(request, response)).title }; %>
<% var view = await confirmPage(request, response); var site = view.site; %>
<h1><%= view.title %></h1>
<% if (view.confirmed != null) { %>
<p class="notice" role="status"><%= site.f("confirm.done", { name: view.confirmed }) %></p>
<p><a href="/"><%= site.t("forum.goHome") %></a></p>
<% } else { %>
<p class="problems"><%= site.t("confirm.invalid") %></p>
<p><a href="/account/sign-in"><%= site.t("nav.signIn") %></a></p>
<% } %>
