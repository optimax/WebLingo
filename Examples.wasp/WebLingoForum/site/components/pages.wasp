<% param site; param base; param page; param pages; %>
<%
  // The page numbers of a list: the first, the last, and those near the page shown, with a gap between, each a link to
  // base with its page in its query, ?page=2 or &page=2, but the page shown.
  var join = base.contains("?") ? "&" : "?";
  var near = [];
  var gap = false;
  for (var n = 1; n <= pages; n++) {
    if (n == 1 || n == pages || (n >= page - 2 && n <= page + 2)) {
      near.push(gap ? -n : n);
      gap = false;
    } else {
      gap = true;
    }
  }
%>
<% if (pages > 1) { %>
<nav class="pages" aria-label="<%= site.t("forum.pages") %>">
<% if (page > 1) { %>  <a rel="prev" href="<%= base + join + $"page={page - 1}" %>"><%= site.t("forum.previous") %></a><% } %>
<% foreach (var n in near) { %><% if (n < 0) { %> <span class="gap">…</span><% } %>
<% var shown = n < 0 ? -n : n; %><% if (shown == page) { %>  <strong aria-current="page"><%= shown %></strong><% } else { %>  <a href="<%= base + join + $"page={shown}" %>"><%= shown %></a><% } %>
<% } %>
<% if (page < pages) { %>  <a rel="next" href="<%= base + join + $"page={page + 1}" %>"><%= site.t("forum.next") %></a><% } %>
</nav>
<% } %>
