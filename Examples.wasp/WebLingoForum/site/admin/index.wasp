<% param request; param response; import { indexPage } from "/lib/administering.wlg"; %>
<% layout "/layouts/main.wasp", { title: (await indexPage(request, response)).title }; %>
<% var view = await indexPage(request, response); var site = view.site; %>
<h1><%= view.title %></h1>
<% if (view.refused != null) { %>
<p class="notice"><%= site.t(view.refused) %></p>
<% } else if (site.user != null) { %>
<ul class="admin">
  <li><a href="/admin/settings"><%= site.t("admin.settings") %></a> <span class="note"><%= site.t("admin.settingsNote") %></span></li>
  <li><a href="/admin/boards"><%= site.t("admin.boards") %></a> <span class="note"><%= site.t("admin.boardsNote") %></span></li>
  <li><a href="/admin/groups"><%= site.t("admin.groups") %></a> <span class="note"><%= site.t("admin.groupsNote") %></span></li>
  <li><a href="/admin/members"><%= site.t("admin.members") %></a> <span class="note"><%= site.t("admin.membersNote") %></span></li>
  <li><a href="/mod/reports"><%= site.t("mod.reports") %></a> · <a href="/mod/log"><%= site.t("log.title") %></a></li>
</ul>
<% } %>
