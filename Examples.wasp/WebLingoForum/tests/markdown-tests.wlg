// The forum's Markdown (site/lib/markdown.wlg): what each kind of markup gives, and that nothing a member writes
// becomes markup of theirs. weblingo test markdown-tests.wlg

import { assertEqual, assertContains } from "std:test";
import { DateTime } from "std:datetime";
import { render, escape, quote } from "../site/lib/markdown.wlg";

export class MarkdownTests {
    testParagraphsKeepTheirLineBreaks() {
        assertEqual(render("Hello,\nworld.\n\nAgain."), "<p>Hello,<br>\nworld.</p>\n<p>Again.</p>\n");
        assertEqual(render(""), "");
        assertEqual(render(null), "");
        assertEqual(render("a\r\nb"), "<p>a<br>\nb</p>\n");
    }

    testEmphasisStrongStruckAndCode() {
        assertEqual(render("*em* _em_ **strong** __strong__ ~~gone~~ `a < b`"),
            "<p><em>em</em> <em>em</em> <strong>strong</strong> <strong>strong</strong> <del>gone</del> <code>a &lt; b</code></p>\n");
        assertEqual(render("**bold *and em***"), "<p><strong>bold <em>and em</em></strong></p>\n");
        assertEqual(render("**bold***"), "<p><strong>bold</strong>*</p>\n");
        assertEqual(render("snake_case_name and 2 * 3 * 4"), "<p>snake_case_name and 2 * 3 * 4</p>\n");
        assertEqual(render("`` a ` b ``"), "<p><code>a ` b</code></p>\n");
        assertEqual(render("\\*not em\\*"), "<p>*not em*</p>\n");
        assertEqual(render("**unclosed"), "<p>**unclosed</p>\n");
    }

    testHeadingsAreBelowThePagesOwn() {
        assertEqual(render("# One\n## Two ##\n###### Six\n#NoSpace"), "<h3>One</h3>\n<h4>Two</h4>\n<h6>Six</h6>\n<p>#NoSpace</p>\n");
    }

    testCodeBlocksAreTextAsItIs() {
        assertEqual(render("```js\nif (a < b) { **x** }\n```"),
            "<pre><code class=\"language-js\">if (a &lt; b) { **x** }\n</code></pre>\n");
        assertEqual(render("~~~\n<script>\n~~~\nafter"), "<pre><code>&lt;script&gt;\n</code></pre>\n<p>after</p>\n");
        assertEqual(render("```\" onmouseover=x\nx\n```"), "<pre><code>x\n</code></pre>\n");
        assertEqual(render("```\nnever closed"), "<pre><code>never closed\n</code></pre>\n");
    }

    testQuotesNest() {
        assertEqual(render("> **Anna** wrote:\n> Tea.\n>> Coffee.\n\nNo."),
            "<blockquote>\n<p><strong>Anna</strong> wrote:<br>\nTea.</p>\n<blockquote>\n<p>Coffee.</p>\n</blockquote>\n</blockquote>\n<p>No.</p>\n");
        var deep = ">".repeat(500) + " deep";
        assertContains(render(deep), "&gt;");
    }

    testLists() {
        assertEqual(render("- one\n- two\n  - nested\n- three"),
            "<ul>\n<li>one</li>\n<li>two\n<ul>\n<li>nested</li>\n</ul></li>\n<li>three</li>\n</ul>\n");
        assertEqual(render("3. three\n4. four"), "<ol start=\"3\">\n<li>three</li>\n<li>four</li>\n</ol>\n");
        assertEqual(render("1) a\n\n2) b"), "<ol>\n<li><p>a</p></li>\n<li><p>b</p></li>\n</ol>\n");
        assertEqual(render("Text\n- item"), "<p>Text</p>\n<ul>\n<li>item</li>\n</ul>\n");
        assertEqual(render("---\n* * *"), "<hr>\n<hr>\n");
    }

    testLinksGoOnlyWhereTheyShould() {
        assertEqual(render("[WebLingo](https://weblingo.dev/docs?a=1&b=2)"),
            "<p><a href=\"https://weblingo.dev/docs?a=1&amp;b=2\" rel=\"nofollow ugc noopener\">WebLingo</a></p>\n");
        assertEqual(render("See https://example.com/x, and <https://example.org>."),
            "<p>See <a href=\"https://example.com/x\" rel=\"nofollow ugc noopener\">https://example.com/x</a>, and "
            + "<a href=\"https://example.org\" rel=\"nofollow ugc noopener\">https://example.org</a>.</p>\n");
        assertEqual(render("[a topic](/topic?id=2)"), "<p><a href=\"/topic?id=2\" rel=\"nofollow ugc noopener\">a topic</a></p>\n");
        assertEqual(render("[x](javascript:alert(1))"), "<p>[x](javascript:alert(1))</p>\n");
        assertEqual(render("[x](//evil.example/)"), "<p>[x](//evil.example/)</p>\n");
        assertEqual(render("[**bold** [inner](https://a.example)](https://b.example)"),
            "<p><a href=\"https://b.example\" rel=\"nofollow ugc noopener\"><strong>bold</strong> [inner](https://a.example)</a></p>\n");
        assertEqual(render("[x](https://e.example/\"onmouseover=\"alert(1))"),
            "<p><a href=\"https://e.example/%22onmouseover=%22alert%281\" rel=\"nofollow ugc noopener\">x</a>)</p>\n");
    }

    testImagesOnlyWhereAllowed() {
        assertEqual(render("![a cup](https://example.com/cup.png)"),
            "<p><a href=\"https://example.com/cup.png\" rel=\"nofollow ugc noopener\">a cup</a></p>\n");
        assertEqual(render("![a cup](https://example.com/cup.png)", { images: true }),
            "<p><img src=\"https://example.com/cup.png\" alt=\"a cup\" loading=\"lazy\"></p>\n");
        assertEqual(render("![x\" onerror=\"y](https://example.com/c.png)", { images: true }),
            "<p><img src=\"https://example.com/c.png\" alt=\"x&quot; onerror=&quot;y\" loading=\"lazy\"></p>\n");
    }

    testNothingAMemberWritesBecomesMarkup() {
        foreach (var hostile in ["<script>alert(1)</script>", "<img src=x onerror=alert(1)>", "<a href=\"javascript:x\">y</a>",
                                 "**<b>**", "[<i>](https://a.example)", "`</code><script>`", "> <iframe>", "- <svg onload=x>",
                                 "# <h1>", "&lt; &amp; \"quoted\" 'single'"]) {
            var html = render(hostile);
            foreach (var tag in ["<script", "<img", "<a href=\"javascript", "<b>", "<i>", "<iframe", "<svg", "<h1>"]) {
                assertEqual(html.contains(tag), false, $"{hostile} gave {html}");
            }
        }
        assertEqual(render("&lt; \"q\""), "<p>&amp;lt; &quot;q&quot;</p>\n");
    }

    testMarkdownEditorWebsExtensions() {
        assertEqual(render("==under== H~2~O x^2^ ~~gone~~"), "<p><u>under</u> H<sub>2</sub>O x<sup>2</sup> <del>gone</del></p>\n");
        assertEqual(render("a == b, 2^10 and ~ alone, ~~~x~~~"), "<p>a == b, 2^10 and ~ alone, ~~~x~~~</p>\n");
        assertEqual(render("- [ ] milk\n- [x] tea\n- plain"),
            "<ul>\n<li class=\"task\"><input type=\"checkbox\" disabled> milk</li>\n"
            + "<li class=\"task\"><input type=\"checkbox\" disabled checked> tea</li>\n<li>plain</li>\n</ul>\n");
        assertEqual(render("| Tea | Price |\n| :--- | ---: |\n| Green | **3** |\n| a \\| b |\nAfter"),
            "<table>\n<thead>\n<tr><th style=\"text-align: left\">Tea</th><th style=\"text-align: right\">Price</th></tr>\n</thead>\n"
            + "<tbody>\n<tr><td style=\"text-align: left\">Green</td><td style=\"text-align: right\"><strong>3</strong></td></tr>\n"
            + "<tr><td style=\"text-align: left\">a | b</td><td style=\"text-align: right\"></td></tr>\n"
            + "<tr><td style=\"text-align: left\">After</td><td style=\"text-align: right\"></td></tr>\n</tbody>\n</table>\n");
        assertEqual(render("a | b\n--- | :-:"), "<table>\n<thead>\n<tr><th>a</th><th style=\"text-align: center\">b</th></tr>\n</thead>\n</table>\n");
        assertEqual(render("a | b\n--- | --- | ---"), "<p>a | b<br>\n--- | --- | ---</p>\n");
        assertEqual(render("| <b>x</b> |\n| --- |"), "<table>\n<thead>\n<tr><th>&lt;b&gt;x&lt;/b&gt;</th></tr>\n</thead>\n</table>\n");
        assertEqual(render("---\ntitle: <Tea>\n---\n# Tea"), "<pre class=\"front-matter\"><code>title: &lt;Tea&gt;\n</code></pre>\n<h3>Tea</h3>\n");
    }

    testANameIsEscapedAndAPostQuoted() {
        assertEqual(escape("Anna_K. *x*"), "Anna\\_K\\. \\*x\\*");
        assertEqual(render(escape("**not bold** [x](https://a.example)")), "<p>**not bold** [x](https://a.example)</p>\n");
        assertEqual(quote("**Anna** wrote:", "Tea.\r\n\r\nCoffee."), "> **Anna** wrote:\n> Tea.\n>\n> Coffee.\n\n");
        assertEqual(render(quote("**Anna** wrote:", "Tea.")), "<blockquote>\n<p><strong>Anna</strong> wrote:<br>\nTea.</p>\n</blockquote>\n");
    }

    testAPathologicalPostRendersInTime() {
        var started = DateTime.utcNow();
        render("*".repeat(5000) + "_".repeat(5000) + "[".repeat(3000) + "`".repeat(3000));
        render("- ".repeat(2000) + "x");
        render(("> " + "- ").repeat(1000) + "x");
        assertEqual(DateTime.utcNow() - started < 10000, true);
    }
}
