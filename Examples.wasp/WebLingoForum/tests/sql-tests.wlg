// What differs in SQL between the forum's four databases (site/lib/sql.wlg). weblingo test sql-tests.wlg

import { assertEqual, assertThrows } from "std:test";
import { Database } from "std:db";
import { columnType, page, providers, insert } from "../site/lib/sql.wlg";

export class SqlTests {
    testEachKindOfColumnHasEachDatabasesType() {
        assertEqual(columnType("sqlite", "id"), "INTEGER PRIMARY KEY");
        assertEqual(columnType("sqlserver", "id"), "BIGINT IDENTITY(1, 1) PRIMARY KEY");
        assertEqual(columnType("mysql", "id"), "BIGINT AUTO_INCREMENT PRIMARY KEY");
        assertEqual(columnType("postgresql", "id"), "BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY");
        assertEqual(columnType("sqlite", "string", 40), "TEXT");
        assertEqual(columnType("sqlserver", "string", 40), "NVARCHAR(40)");
        assertEqual(columnType("mysql", "string", 40), "VARCHAR(40)");
        assertEqual(columnType("postgresql", "string", 40), "VARCHAR(40)");
        assertEqual(columnType("sqlserver", "text"), "NVARCHAR(MAX)");
        assertEqual(columnType("mysql", "text"), "MEDIUMTEXT");
        assertEqual(columnType("sqlserver", "boolean"), "BIT");
        assertEqual(columnType("postgresql", "date"), "TIMESTAMPTZ(3)");
        foreach (var provider in providers) {
            foreach (var type in ["id", "integer", "boolean", "string", "text", "date"]) {
                assertEqual(columnType(provider, type, 10) is String, true);
            }
        }
    }

    testAnUnknownDatabaseOrKindIsAnError() {
        assertEqual(assertThrows(() => columnType("oracle", "id")).message, "The forum does not run on the database 'oracle'.");
        assertEqual(assertThrows(() => columnType("sqlite", "blob")).message, "'blob' is not a kind of column of the forum's.");
    }

    testAPageOfRows() {
        assertEqual(page("sqlserver"), "OFFSET @skip ROWS FETCH NEXT @count ROWS ONLY");
        assertEqual(page("sqlite"), "LIMIT @count OFFSET @skip");
        assertEqual(page("mysql"), "LIMIT @count OFFSET @skip");
        assertEqual(page("postgresql"), "LIMIT @count OFFSET @skip");
    }

    async testAnInsertGivesItsRowsId() {
        using (var db = await Database.open("sqlite::memory:")) {
            await db.execute("CREATE TABLE things (id INTEGER PRIMARY KEY, name TEXT NOT NULL)");
            assertEqual(await insert(db, "things", { name: "first" }), 1);
            assertEqual(await insert(db, "things", { name: "second" }), 2);
            assertEqual((await db.query("SELECT name FROM things WHERE id = 2"))[0]["name"], "second");
        }
    }
}
