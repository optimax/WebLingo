<% 
  import { featured } from "/lib/teas.wlg";
  layout "/layouts/main.wasp", { title: "Welcome", section: "home" };
%>

<section class="hero">
  <h1>Tea, brewed well.</h1>
  <p>Six teas from four countries, and how to brew each of them.</p>
  <p><a class="button" href="/teas">See our teas</a></p>
</section>
<h2>This week's teas</h2>
<div class="cards">
<% 
  foreach (var tea in featured()) { 
    await renderComponent("/components/tea-card.wasp", { tea: tea }); 
  } 
%>
</div>
